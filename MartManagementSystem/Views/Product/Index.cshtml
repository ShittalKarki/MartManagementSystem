@model IEnumerable<MartManagementSystem.Models.Product>
@{
    ViewData["Title"] = "Product Inventory";
}

<div class="header-wrapper">
    <div>
        <h1 class="page-title">Product Inventory</h1>
        <p class="page-subtitle">Manage stock levels, unit prices, and active product listings.</p>
    </div>
    <a asp-action="Create" class="btn-primary" id="btn-add-product">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <line x1="12" y1="5" x2="12" y2="19"></line>
            <line x1="5" y1="12" x2="19" y2="12"></line>
        </svg>
        Add Product
    </a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success" role="alert">
        <span class="alert-icon">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
        </span>
        @TempData["SuccessMessage"]
    </div>
}

<div class="panel">
    <div class="table-responsive">
        <table class="custom-table" id="products-table">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Product Name</th>
                    <th>Unit Price</th>
                    <th>Stock</th>
                    <th>Status</th>
                    <th style="text-align: right;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    @foreach (var p in Model)
                    {
                        <tr>
                            <td><span class="table-id">#@p.Id</span></td>
                            <td class="table-name">@p.Name</td>
                            <td class="table-amount">$@p.Price.ToString("N2")</td>
                            <td>@p.Stock</td>
                            <td>
                                @if (p.Stock == 0)
                                {
                                    <span class="badge badge-danger">Out of stock</span>
                                }
                                else if (p.Stock < 10)
                                {
                                    <span class="badge badge-warning">Low stock</span>
                                }
                                else
                                {
                                    <span class="badge badge-success">In stock</span>
                                }
                            </td>
                            <td>
                                <div class="table-actions">
                                    <a asp-action="Edit" asp-route-id="@p.Id" class="btn-secondary btn-sm" id="edit-product-@p.Id">
                                        Edit
                                    </a>
                                    <form asp-action="Delete" asp-route-id="@p.Id" method="post"
                                          onsubmit="return confirm('Delete \'@p.Name\'? This cannot be undone.');"
                                          style="display:inline;">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn-danger btn-sm" id="delete-product-@p.Id">
                                            Delete
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6">
                            <div class="empty-state">
                                <div class="empty-state-icon">📦</div>
                                <div class="empty-state-text">No products found. Add your first product to get started.</div>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
