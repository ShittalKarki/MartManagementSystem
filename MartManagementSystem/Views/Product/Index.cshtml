@model IEnumerable<MartManagementSystem.Models.Product>
@{
    ViewData["Title"] = "Product Inventory";
}

<div class="header-wrapper">
    <div>
        <h1 class="page-title">Product Inventory</h1>
        <p style="color: var(--text-secondary); margin-top: 0.25rem;">Monitor stock levels, unit prices, and add new inventory products.</p>
    </div>
    <a href="@Url.Action("Create")" class="btn-primary">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
        Add Product
    </a>
</div>

<div class="panel">
    <div class="table-responsive">
        <table class="custom-table">
            <thead>
                <tr>
                    <th>Product ID</th>
                    <th>Name</th>
                    <th>Price</th>
                    <th>Stock</th>
                    <th>Status</th>
                    <th style="text-align: right;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    @foreach (var p in Model)
                    {
                        <tr>
                            <td>#@p.Id</td>
                            <td style="font-weight: 600;">@p.Name</td>
                            <td>$@p.Price.ToString("N2")</td>
                            <td>@p.Stock</td>
                            <td>
                                @if (p.Stock == 0)
                                {
                                    <span class="badge badge-danger">Out of stock</span>
                                }
                                else if (p.Stock < 10)
                                {
                                    <span class="badge badge-warning">Low stock</span>
                                }
                                else
                                {
                                    <span class="badge badge-success">In stock</span>
                                }
                            </td>
                            <td style="text-align: right;">
                                <div style="display: inline-flex; gap: 0.5rem; justify-content: flex-end; align-items: center;">
                                    <a href="@Url.Action("Edit", new { id = p.Id })" class="btn-secondary" style="padding: 0.4rem 0.8rem; font-size: 0.85rem; border-radius: 8px;">
                                        Edit
                                    </a>
                                    <form asp-action="Delete" asp-route-id="@p.Id" method="post" onsubmit="return confirm('Are you sure you want to delete this product?');" style="display:inline;">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn-secondary" style="padding: 0.4rem 0.8rem; font-size: 0.85rem; border-radius: 8px; color: var(--accent-rose); border-color: rgba(244, 63, 94, 0.2); background: rgba(244, 63, 94, 0.02);">
                                            Delete
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6" style="text-align: center; color: var(--text-muted); padding: 3rem;">
                            No products found in inventory.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
