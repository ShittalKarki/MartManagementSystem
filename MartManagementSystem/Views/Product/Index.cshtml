@model IEnumerable<MartManagementSystem.Models.Product>
@{
    ViewData["Title"] = "Product Inventory";
}

<style>
    .filter-btn {
        transition: all 0.2s var(--ease);
        cursor: pointer;
        outline: none;
    }
    .filter-btn:hover {
        color: var(--text-1) !important;
        background: rgba(255, 255, 255, 0.05) !important;
    }
    .filter-btn.active {
        color: #fff !important;
        background: linear-gradient(135deg, var(--blue), var(--purple)) !important;
        box-shadow: 0 2px 10px rgba(59, 130, 246, 0.25);
    }
</style>

<div class="header-wrapper">
    <div>
        <h1 class="page-title">Product Inventory</h1>
        <p class="page-subtitle">Manage stock levels, unit prices, and active product listings.</p>
    </div>
    <a asp-action="Create" class="btn-primary" id="btn-add-product">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <line x1="12" y1="5" x2="12" y2="19"></line>
            <line x1="5" y1="12" x2="19" y2="12"></line>
        </svg>
        Add Product
    </a>
</div>

<div class="panel">
    <!-- Search and Filters Panel -->
    <div style="display: flex; gap: 0.85rem; flex-wrap: wrap; align-items: center; width: 100%; margin-bottom: 1.5rem;">
        <div style="position: relative; flex: 1; min-width: 250px;">
            <input type="text" id="productSearch" class="form-control" placeholder="Search products by ID, name..." style="padding-left: 2.75rem;" />
            <svg style="position: absolute; left: 1rem; top: 13px; color: var(--text-3);" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                <circle cx="11" cy="11" r="8"></circle>
                <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            </svg>
        </div>
        
        <div style="display: inline-flex; gap: 0.35rem; background: rgba(255,255,255,0.03); border: 1px solid var(--border); padding: 0.25rem; border-radius: var(--radius-md);">
            <button class="filter-btn active" data-status="all" style="background: none; border: none; padding: 0.45rem 1rem; border-radius: var(--radius-sm); color: var(--text-2); font-size: 0.82rem; font-weight: 600;">All</button>
            <button class="filter-btn" data-status="instock" style="background: none; border: none; padding: 0.45rem 1rem; border-radius: var(--radius-sm); color: var(--text-2); font-size: 0.82rem; font-weight: 600;">In Stock</button>
            <button class="filter-btn" data-status="lowstock" style="background: none; border: none; padding: 0.45rem 1rem; border-radius: var(--radius-sm); color: var(--text-2); font-size: 0.82rem; font-weight: 600;">Low Stock</button>
            <button class="filter-btn" data-status="outofstock" style="background: none; border: none; padding: 0.45rem 1rem; border-radius: var(--radius-sm); color: var(--text-2); font-size: 0.82rem; font-weight: 600;">Out of Stock</button>
        </div>
    </div>

    <div class="table-responsive">
        <table class="custom-table" id="products-table">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Product Name</th>
                    <th>Unit Price</th>
                    <th>Stock</th>
                    <th>Status</th>
                    <th style="text-align: right;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    @foreach (var p in Model)
                    {
                        var statusClass = p.Stock == 0 ? "outofstock" : p.Stock < 10 ? "lowstock" : "instock";
                        <tr class="product-row" data-name="@p.Name.ToLower()" data-id="@p.Id" data-stock-status="@statusClass">
                            <td><span class="table-id">#@p.Id</span></td>
                            <td class="table-name">@p.Name</td>
                            <td class="table-amount">$@p.Price.ToString("N2")</td>
                            <td style="font-variant-numeric: tabular-nums;">@p.Stock</td>
                            <td>
                                @if (p.Stock == 0)
                                {
                                    <span class="badge badge-danger">Out of stock</span>
                                }
                                else if (p.Stock < 10)
                                {
                                    <span class="badge badge-warning">Low stock</span>
                                }
                                else
                                {
                                    <span class="badge badge-success">In stock</span>
                                }
                            </td>
                            <td>
                                <div class="table-actions">
                                    <a asp-action="Edit" asp-route-id="@p.Id" class="btn-secondary btn-sm" id="edit-product-@p.Id">
                                        Edit
                                    </a>
                                    <form asp-action="Delete" asp-route-id="@p.Id" method="post"
                                          onsubmit="return confirm('Delete \'@p.Name\'? This cannot be undone.');"
                                          style="display:inline;">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn-danger btn-sm" id="delete-product-@p.Id">
                                            Delete
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                    
                    <!-- Empty Search Result Template Row -->
                    <tr id="empty-search-row" style="display: none;">
                        <td colspan="6">
                            <div class="empty-state">
                                <div class="empty-state-icon">🔍</div>
                                <div class="empty-state-text">No products match your search or filter criteria.</div>
                            </div>
                        </td>
                    </tr>
                }
                else
                {
                    <tr>
                        <td colspan="6">
                            <div class="empty-state">
                                <div class="empty-state-icon">📦</div>
                                <div class="empty-state-text">No products found. Add your first product to get started.</div>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function() {
            const searchInput = document.getElementById("productSearch");
            const filterButtons = document.querySelectorAll(".filter-btn");
            const rows = document.querySelectorAll(".product-row");
            const emptyStateRow = document.getElementById("empty-search-row");

            let activeStatus = "all";
            let searchQuery = "";

            function filterTable() {
                let visibleCount = 0;
                rows.forEach(row => {
                    const name = row.getAttribute("data-name") || "";
                    const id = row.getAttribute("data-id") || "";
                    const status = row.getAttribute("data-stock-status") || "";

                    const matchesSearch = name.includes(searchQuery) || id.includes(searchQuery);
                    const matchesStatus = (activeStatus === "all") || (status === activeStatus);

                    if (matchesSearch && matchesStatus) {
                        row.style.display = "";
                        visibleCount++;
                    } else {
                        row.style.display = "none";
                    }
                });

                if (emptyStateRow) {
                    emptyStateRow.style.display = (visibleCount === 0 && rows.length > 0) ? "" : "none";
                }
            }

            if (searchInput) {
                searchInput.addEventListener("input", function() {
                    searchQuery = searchInput.value.toLowerCase().trim();
                    filterTable();
                });
            }

            filterButtons.forEach(btn => {
                btn.addEventListener("click", function() {
                    filterButtons.forEach(b => b.classList.remove("active"));
                    btn.classList.add("active");
                    activeStatus = btn.getAttribute("data-status");
                    filterTable();
                });
            });
        });
    </script>
}
