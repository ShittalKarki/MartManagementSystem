@model MartManagementSystem.Models.Product
@{
    ViewData["Title"] = "Edit Product";
}

<div class="header-wrapper">
    <div>
        <h1 class="page-title">Edit Product Details</h1>
        <p style="color: var(--text-secondary); margin-top: 0.25rem;">Modify properties and stock details for "@Model.Name".</p>
    </div>
    <a href="@Url.Action("Index")" class="btn-secondary">Back to List</a>
</div>

<div class="panel form-panel">
    <form asp-action="Edit" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />
        
        <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>

        <div class="form-group">
            <label asp-for="Name" class="form-label">Product Name</label>
            <input asp-for="Name" class="form-control" placeholder="e.g., Organic Honey (500g)" required />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="Price" class="form-label">Unit Price ($)</label>
            <input asp-for="Price" class="form-control" type="number" step="0.01" min="0" placeholder="0.00" required />
            <span asp-validation-for="Price" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="Stock" class="form-label">Current Stock Quantity</label>
            <input asp-for="Stock" class="form-control" type="number" min="0" placeholder="0" required />
            <span asp-validation-for="Stock" class="text-danger"></span>
        </div>

        <div class="form-actions">
            <a href="@Url.Action("Index")" class="btn-secondary">Cancel</a>
            <button type="submit" class="btn-primary">Save Changes</button>
        </div>
    </form>
</div>
