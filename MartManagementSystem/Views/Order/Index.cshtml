@model IEnumerable<MartManagementSystem.Models.Order>
@{
    ViewData["Title"] = "Order Logs";
}

<div class="header-wrapper">
    <div>
        <h1 class="page-title">Sales Order Logs</h1>
        <p style="color: var(--text-secondary); margin-top: 0.25rem;">View active transactions, order details, and process cancellations.</p>
    </div>
    <a href="@Url.Action("Create")" class="btn-primary">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M11 5H4v2h7V5zm0 4H4v2h7V9zm-7 6h5v-2H4v2zm0 4h5v-2H4v2zm9-12h7v2h-7V7zm0 4h7v2h-7v-2z"></path></svg>
        New Sales Order
    </a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
        @TempData["SuccessMessage"]
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
        @TempData["ErrorMessage"]
    </div>
}

<div class="panel">
    <div class="table-responsive">
        <table class="custom-table">
            <thead>
                <tr>
                    <th>Order ID</th>
                    <th>Customer Name</th>
                    <th>Product</th>
                    <th>Quantity</th>
                    <th>Unit Price</th>
                    <th>Total Cost</th>
                    <th>Order Date</th>
                    <th style="text-align: right;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    @foreach (var o in Model)
                    {
                        var unitPrice = o.Product?.Price ?? 0;
                        var totalCost = o.Quantity * unitPrice;
                        <tr>
                            <td>#@o.Id</td>
                            <td style="font-weight: 600;">@(o.Customer?.FullName ?? "Deleted Customer")</td>
                            <td>@(o.Product?.Name ?? "Deleted Product")</td>
                            <td>@o.Quantity</td>
                            <td>$@unitPrice.ToString("N2")</td>
                            <td style="color: var(--accent-blue); font-weight: 600;">$@totalCost.ToString("N2")</td>
                            <td>@o.OrderDate.ToString("MM/dd/yyyy HH:mm")</td>
                            <td style="text-align: right;">
                                <form asp-action="Delete" asp-route-id="@o.Id" method="post" onsubmit="return confirm('Are you sure you want to cancel this order? This will restock the items.');" style="display:inline;">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn-secondary" style="padding: 0.4rem 0.8rem; font-size: 0.85rem; border-radius: 8px; color: var(--accent-rose); border-color: rgba(244, 63, 94, 0.2); background: rgba(244, 63, 94, 0.02);">
                                        Cancel Order
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="8" style="text-align: center; color: var(--text-muted); padding: 3rem;">
                            No sales orders recorded yet.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
