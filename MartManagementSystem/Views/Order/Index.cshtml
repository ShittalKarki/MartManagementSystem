@model IEnumerable<MartManagementSystem.Models.Order>
@{
    ViewData["Title"] = "Order Logs";
}

<div class="header-wrapper">
    <div>
        <h1 class="page-title">Sales Order Logs</h1>
        <p style="color: var(--text-secondary); margin-top: 0.25rem;">View active transactions, order details, and process cancellations.</p>
    </div>
    <a href="@Url.Action("Create")" class="btn-primary">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M11 5H4v2h7V5zm0 4H4v2h7V9zm-7 6h5v-2H4v2zm0 4h5v-2H4v2zm9-12h7v2h-7V7zm0 4h7v2h-7v-2z"></path></svg>
        New Sales Order
    </a>
</div>

<div class="panel">
    <!-- Live Search Bar -->
    <div style="position: relative; width: 100%; margin-bottom: 1.5rem;">
        <input type="text" id="orderSearch" class="form-control" placeholder="Search orders by ID, customer name, product name..." style="padding-left: 2.75rem;" />
        <svg style="position: absolute; left: 1rem; top: 13px; color: var(--text-3);" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
    </div>

    <div class="table-responsive">
        <table class="custom-table" id="orders-table">
            <thead>
                <tr>
                    <th>Order ID</th>
                    <th>Customer Name</th>
                    <th>Product</th>
                    <th>Quantity</th>
                    <th>Unit Price</th>
                    <th>Total Cost</th>
                    <th>Order Date</th>
                    <th style="text-align: right;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    @foreach (var o in Model)
                    {
                        var unitPrice = o.Product?.Price ?? 0;
                        var totalCost = o.Quantity * unitPrice;
                        var custName = o.Customer?.FullName ?? "Deleted Customer";
                        var prodName = o.Product?.Name ?? "Deleted Product";
                        
                        <tr class="order-row" data-customer="@custName.ToLower()" data-product="@prodName.ToLower()" data-id="@o.Id">
                            <td><span class="table-id">#@o.Id</span></td>
                            <td style="font-weight: 600;">@custName</td>
                            <td>@prodName</td>
                            <td style="font-variant-numeric: tabular-nums;">@o.Quantity</td>
                            <td style="font-variant-numeric: tabular-nums;">$@unitPrice.ToString("N2")</td>
                            <td style="color: var(--accent-blue); font-weight: 600; font-variant-numeric: tabular-nums;">$@totalCost.ToString("N2")</td>
                            <td class="table-mono">@o.OrderDate.ToString("MM/dd/yyyy HH:mm")</td>
                            <td style="text-align: right;">
                                <form asp-action="Delete" asp-route-id="@o.Id" method="post" onsubmit="return confirm('Are you sure you want to cancel this order? This will restock the items.');" style="display:inline;">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn-secondary" style="padding: 0.4rem 0.8rem; font-size: 0.85rem; border-radius: 8px; color: var(--accent-rose); border-color: rgba(244, 63, 94, 0.2); background: rgba(244, 63, 94, 0.02);">
                                        Cancel Order
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }

                    <!-- Empty Search Result Template Row -->
                    <tr id="empty-search-row" style="display: none;">
                        <td colspan="8">
                            <div class="empty-state">
                                <div class="empty-state-icon">🔍</div>
                                <div class="empty-state-text">No order logs match your search query.</div>
                            </div>
                        </td>
                    </tr>
                }
                else
                {
                    <tr>
                        <td colspan="8" style="text-align: center; color: var(--text-muted); padding: 3rem;">
                            No sales orders recorded yet.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function() {
            const searchInput = document.getElementById("orderSearch");
            const rows = document.querySelectorAll(".order-row");
            const emptyStateRow = document.getElementById("empty-search-row");

            if (searchInput) {
                searchInput.addEventListener("input", function() {
                    const query = searchInput.value.toLowerCase().trim();
                    let visibleCount = 0;

                    rows.forEach(row => {
                        const customer = row.getAttribute("data-customer") || "";
                        const product = row.getAttribute("data-product") || "";
                        const id = row.getAttribute("data-id") || "";

                        const match = customer.includes(query) || product.includes(query) || id.includes(query);
                        if (match) {
                            row.style.display = "";
                            visibleCount++;
                        } else {
                            row.style.display = "none";
                        }
                    });

                    if (emptyStateRow) {
                        emptyStateRow.style.display = (visibleCount === 0 && rows.length > 0) ? "" : "none";
                    }
                });
            }
        });
    </script>
}
