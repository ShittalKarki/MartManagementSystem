@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "Home";
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "Index";

    string sectionLabel = currentController switch
    {
        "Product"  => "Products",
        "Customer" => "Customers",
        "Order"    => "Orders",
        _          => "Dashboard"
    };
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Mart Management System — Manage products, customers, and sales orders in one place." />
    <title>@ViewData["Title"] — MartSystem</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <div class="app-container">

        <!-- ────── Sidebar ────── -->
        <aside class="sidebar" id="sidebar">
            <div class="sidebar-brand">
                <svg width="30" height="30" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M3 3H5L5.4 5M5.4 5H21L19 13H7M5.4 5L7 13m0 0L6 17H19M7 13L6 17M9 20C9 20.5523 8.55228 21 8 21C7.44772 21 7 20.5523 7 20C7 19.4477 7.44772 19 8 19C8.55228 19 9 19.4477 9 20ZM19 20C19 20.5523 18.5523 21 18 21C17.4477 21 17 20.5523 17 20C17 19.4477 17.4477 19 18 19C18.5523 19 19 19.4477 19 20Z" stroke="url(#brand-grad)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                    <defs>
                        <linearGradient id="brand-grad" x1="3" y1="3" x2="21" y2="21" gradientUnits="userSpaceOnUse">
                            <stop stop-color="#60a5fa" />
                            <stop offset="1" stop-color="#c084fc" />
                        </linearGradient>
                    </defs>
                </svg>
                <span class="brand-text">MartSystem</span>
            </div>

            <nav aria-label="Main Navigation">
                <p class="nav-section-label">MAIN MENU</p>
                <ul class="sidebar-menu">
                    <li>
                        <a href="@Url.Action("Index", "Home")"
                           class="sidebar-link @(currentController == "Home" ? "active" : "")"
                           id="nav-dashboard">
                            <span class="nav-icon">
                                <svg viewBox="0 0 24 24" fill="currentColor"><path d="M3 13h1v7c0 1.103.897 2 2 2h12c1.103 0 2-.897 2-2v-7h1a1 1 0 0 0 .707-1.707l-9-9a.999.999 0 0 0-1.414 0l-9 9A1 1 0 0 0 3 13zm7 7v-5h4v5h-4z" /></svg>
                            </span>
                            <span class="nav-label">Dashboard</span>
                        </a>
                    </li>
                    <li>
                        <a href="@Url.Action("Index", "Product")"
                           class="sidebar-link @(currentController == "Product" ? "active" : "")"
                           id="nav-products">
                            <span class="nav-icon">
                                <svg viewBox="0 0 24 24" fill="currentColor"><path d="M21.822 7.431A1 1 0 0 0 21 7H3a1 1 0 0 0-.822.431 1 1 0 0 0 .025 1.066l2 3A1 1 0 0 0 5 12h14a1 1 0 0 0 .797-.393l2-3a1 1 0 0 0 .025-1.076zM5.586 10l-1.333-2h15.494l-1.333 2H5.586zM2 14h20v2H2zm0 4h20v2H2z" /></svg>
                            </span>
                            <span class="nav-label">Products</span>
                        </a>
                    </li>
                    <li>
                        <a href="@Url.Action("Index", "Customer")"
                           class="sidebar-link @(currentController == "Customer" ? "active" : "")"
                           id="nav-customers">
                            <span class="nav-icon">
                                <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.579 2 2 6.579 2 12s4.579 10 10 10 10-4.579 10-10S17.421 2 12 2zm0 3c1.93 0 3.5 1.57 3.5 3.5S13.93 12 12 12s-3.5-1.57-3.5-3.5S10.07 5 12 5zm0 14c-3.86 0-7-2.69-7-6 0-.552.448-1 1-1h12c.552 0 1 .448 1 1 0 3.31-3.14 6-7 6z" /></svg>
                            </span>
                            <span class="nav-label">Customers</span>
                        </a>
                    </li>
                    <li>
                        <a href="@Url.Action("Index", "Order")"
                           class="sidebar-link @(currentController == "Order" ? "active" : "")"
                           id="nav-orders">
                            <span class="nav-icon">
                                <svg viewBox="0 0 24 24" fill="currentColor"><path d="M19 15v-3h-2v3h-3v2h3v3h2v-3h3v-2h-3zM11 5H4v2h7V5zm0 4H4v2h7V9zm-7 6h5v-2H4v2zm0 4h5v-2H4v2zm9-12h7v2h-7V7zm0 4h7v2h-7v-2z" /></svg>
                            </span>
                            <span class="nav-label">Orders</span>
                        </a>
                    </li>
                </ul>

                <p class="nav-section-label" style="margin-top: 2rem;">QUICK ADD</p>
                <ul class="sidebar-menu">
                    <li>
                        <a href="@Url.Action("Create", "Product")"
                           class="sidebar-link @(currentController == "Product" && currentAction == "Create" ? "active" : "")"
                           id="nav-add-product">
                            <span class="nav-icon">
                                <svg viewBox="0 0 24 24" fill="currentColor"><path d="M19 11h-6V5h-2v6H5v2h6v6h2v-6h6z" /></svg>
                            </span>
                            <span class="nav-label">Add Product</span>
                        </a>
                    </li>
                    <li>
                        <a href="@Url.Action("Create", "Customer")"
                           class="sidebar-link @(currentController == "Customer" && currentAction == "Create" ? "active" : "")"
                           id="nav-add-customer">
                            <span class="nav-icon">
                                <svg viewBox="0 0 24 24" fill="currentColor"><path d="M15 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm-9-2V7H4v3H1v2h3v3h2v-3h3v-2H6zm9 4c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z" /></svg>
                            </span>
                            <span class="nav-label">Add Customer</span>
                        </a>
                    </li>
                    <li>
                        <a href="@Url.Action("Create", "Order")"
                           class="sidebar-link @(currentController == "Order" && currentAction == "Create" ? "active" : "")"
                           id="nav-new-order">
                            <span class="nav-icon">
                                <svg viewBox="0 0 24 24" fill="currentColor"><path d="M17 12h-5v5h5v-5zM16 1v2H8V1H6v2H5c-1.11 0-1.99.9-1.99 2L3 19c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2h-1V1h-2zm3 18H5V8h14v11z" /></svg>
                            </span>
                            <span class="nav-label">New Order</span>
                        </a>
                    </li>
                </ul>
            </nav>

            <div class="sidebar-footer">
                <div class="sidebar-footer-info">
                    <div class="sidebar-footer-icon">
                        <svg viewBox="0 0 24 24" fill="currentColor" width="18" height="18"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 14.5v-9l6 4.5-6 4.5z" /></svg>
                    </div>
                    <div>
                        <div class="footer-title">MartSystem v1.0</div>
                        <div class="footer-sub">ASP.NET Core 9</div>
                    </div>
                </div>
            </div>
        </aside>

        <!-- ────── Main Column ────── -->
        <div class="main-wrapper">

            <!-- Top Bar -->
            <header class="topbar">
                <button class="sidebar-toggle" id="sidebarToggle" aria-label="Toggle sidebar">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="3" y1="6" x2="21" y2="6"></line>
                        <line x1="3" y1="12" x2="21" y2="12"></line>
                        <line x1="3" y1="18" x2="21" y2="18"></line>
                    </svg>
                </button>

                <nav class="breadcrumb-nav" aria-label="Breadcrumb">
                    <a href="@Url.Action("Index", "Home")" class="breadcrumb-home">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M3 13h1v7c0 1.103.897 2 2 2h12c1.103 0 2-.897 2-2v-7h1a1 1 0 0 0 .707-1.707l-9-9a.999.999 0 0 0-1.414 0l-9 9A1 1 0 0 0 3 13zm7 7v-5h4v5h-4z" /></svg>
                        Home
                    </a>
                    @if (currentController != "Home")
                    {
                        <span class="breadcrumb-sep">›</span>
                        <span class="breadcrumb-current">@sectionLabel</span>
                    }
                    @if (currentAction == "Create")
                    {
                        <span class="breadcrumb-sep">›</span>
                        <span class="breadcrumb-current">Create</span>
                    }
                    @if (currentAction == "Edit")
                    {
                        <span class="breadcrumb-sep">›</span>
                        <span class="breadcrumb-current">Edit</span>
                    }
                </nav>

                <div class="topbar-actions">
                    <div class="topbar-time" id="topbarTime"></div>
                    <a href="@Url.Action("Create", "Order")" class="topbar-cta" id="topbar-new-order-btn">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
                        New Order
                    </a>
                </div>
            </header>

            <!-- Page Content -->
            <main class="main-content" role="main">
                @RenderBody()
            </main>

            <!-- Footer -->
            <footer class="app-footer">
                <span>© @DateTime.Now.Year MartSystem. All rights reserved.</span>
                <span>Built with ASP.NET Core 9 &amp; EF Core</span>
            </footer>
        </div>
    </div>

    <!-- Toast Container -->
    <div id="toast-container" aria-live="polite" aria-atomic="true"></div>

    <!-- Core Scripts -->
    <script>
        // Live clock
        function updateClock() {
            const el = document.getElementById('topbarTime');
            if (!el) return;
            const now = new Date();
            el.textContent = now.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
        }
        updateClock();
        setInterval(updateClock, 1000);

        // Sidebar toggle for mobile / collapsed mode
        const toggleBtn = document.getElementById('sidebarToggle');
        const sidebar   = document.getElementById('sidebar');
        if (toggleBtn && sidebar) {
            toggleBtn.addEventListener('click', () => {
                sidebar.classList.toggle('collapsed');
                document.querySelector('.main-wrapper')?.classList.toggle('sidebar-collapsed');
            });
        }

        // Auto-dismiss alerts after 5 s
        document.querySelectorAll('.alert').forEach(el => {
            setTimeout(() => {
                el.style.transition = 'opacity 0.4s ease, transform 0.4s ease';
                el.style.opacity    = '0';
                el.style.transform  = 'translateY(-8px)';
                setTimeout(() => el.remove(), 400);
            }, 5000);
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
