@model MartManagementSystem.Services.DashboardDto
@{
    ViewData["Title"] = "Dashboard";

    // Setup coordinates and scaling for SVG sales chart
    var maxVal = Model.LastSevenDaysSales.Max();
    if (maxVal == 0) maxVal = 100; // prevent division by zero
    
    double width = 600;
    double height = 180;
    double padding = 35;
    double chartW = width - (padding * 2);
    double chartH = height - (padding * 2);

    var daysOfWeek = new List<string>();
    var today = DateTime.Today;
    for (int i = 6; i >= 0; i--)
    {
        daysOfWeek.Add(today.AddDays(-i).ToString("ddd"));
    }

    var pointsList = new List<string>();
    var areaPointsList = new List<string>();
    var chartPoints = "";
    var chartBars = new List<(double x, double y, double h, string dateVal, decimal amt)>();

    // Start coordinate of the fill area
    areaPointsList.Add($"{padding},{height - padding}");

    for (int i = 0; i < 7; i++)
    {
        double x = padding + (chartW / 6.0) * i;
        double ratio = (double)Model.LastSevenDaysSales[i] / (double)maxVal;
        double y = (height - padding) - (chartH * ratio);
        pointsList.Add($"{x},{y}");
        areaPointsList.Add($"{x},{y}");
        chartBars.Add((x, y, (height - padding) - y, daysOfWeek[i], Model.LastSevenDaysSales[i]));
    }

    // End coordinate of the fill area
    areaPointsList.Add($"{padding + chartW},{height - padding}");

    chartPoints = string.Join(" ", pointsList);
    var areaPoints = string.Join(" ", areaPointsList);
}

<style>
    .dashboard-bottom-grid {
        display: grid;
        grid-template-columns: 3fr 2fr;
        gap: 1.5rem;
        align-items: start;
        margin-bottom: 2rem;
    }
    @@media (max-width: 992px) {
        .dashboard-bottom-grid {
            grid-template-columns: 1fr;
        }
    }
    .chart-tooltip-group {
        pointer-events: none;
    }
    circle:hover + .chart-tooltip-group {
        opacity: 1 !important;
    }
</style>

<div class="header-wrapper">
    <div>
        <h1 class="page-title">Dashboard Overview</h1>
        <p class="page-subtitle">Your mart's business snapshot — updated in real time.</p>
    </div>
</div>

<!-- ── Main Stats Cards ── -->
<div class="stats-grid">
    <div class="stat-card" style="--card-accent: var(--blue);">
        <div class="stat-icon">
            <svg viewBox="0 0 24 24"><path d="M11.8 10.9c-2.27-.59-3-1.2-3-2.15 0-1.09 1.01-1.85 2.7-1.85 1.78 0 2.44.85 2.5 2.1h2.21c-.07-1.72-1.12-3.3-3.21-3.81V3h-3v2.16c-1.94.42-3.5 1.68-3.5 3.61 0 2.31 1.91 3.46 4.7 4.13 2.5.6 3 1.48 3 2.41 0 .69-.49 1.79-2.7 1.79-2.06 0-2.87-.92-2.98-2.1h-2.2c.12 2.19 1.76 3.42 3.68 3.83V21h3v-2.15c1.95-.37 3.5-1.5 3.5-3.55 0-2.84-2.43-3.81-4.7-4.4z"/></svg>
        </div>
        <div class="stat-label">Total Revenue</div>
        <div class="stat-value">$@Model.TotalSales.ToString("N2")</div>
    </div>

    <div class="stat-card" style="--card-accent: var(--purple);">
        <div class="stat-icon" style="background: var(--purple-dim); color: var(--purple);">
            <svg viewBox="0 0 24 24"><path d="M19 15v-3h-2v3h-3v2h3v3h2v-3h3v-2h-3zM11 5H4v2h7V5zm0 4H4v2h7V9zm-7 6h5v-2H4v2zm0 4h5v-2H4v2zm9-12h7v2h-7V7zm0 4h7v2h-7v-2z"/></svg>
        </div>
        <div class="stat-label">Total Orders</div>
        <div class="stat-value">@Model.TotalOrders</div>
    </div>

    <div class="stat-card" style="--card-accent: var(--emerald);">
        <div class="stat-icon" style="background: var(--emerald-dim); color: var(--emerald);">
            <svg viewBox="0 0 24 24"><path d="M21.822 7.431A1 1 0 0 0 21 7H3a1 1 0 0 0-.822.431 1 1 0 0 0 .025 1.066l2 3A1 1 0 0 0 5 12h14a1 1 0 0 0 .797-.393l2-3a1 1 0 0 0 .025-1.076zM5.586 10l-1.333-2h15.494l-1.333 2H5.586zM2 14h20v2H2zm0 4h20v2H2z"/></svg>
        </div>
        <div class="stat-label">Active Products</div>
        <div class="stat-value">@Model.TotalProducts</div>
    </div>

    <div class="stat-card" style="--card-accent: var(--amber);">
        <div class="stat-icon" style="background: var(--amber-dim); color: var(--amber);">
            <svg viewBox="0 0 24 24"><path d="M12 2C6.579 2 2 6.579 2 12s4.579 10 10 10 10-4.579 10-10S17.421 2 12 2zm0 3c1.93 0 3.5 1.57 3.5 3.5S13.93 12 12 12s-3.5-1.57-3.5-3.5S10.07 5 12 5zm0 14c-3.86 0-7-2.69-7-6 0-.552.448-1 1-1h12c.552 0 1 .448 1 1 0 3.31-3.14 6-7 6z"/></svg>
        </div>
        <div class="stat-label">Customers</div>
        <div class="stat-value">@Model.TotalCustomers</div>
    </div>
</div>

<!-- ── Advanced Analytics KPI Grid ── -->
<div class="stats-grid" style="grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); margin-bottom: 2rem;">
    <div class="stat-card" style="--card-accent: var(--blue); padding: 1.25rem 1.5rem;">
        <div class="stat-icon" style="width: 32px; height: 32px; margin-bottom: 0.5rem; background: var(--blue-dim); color: var(--blue);">
            <svg viewBox="0 0 24 24" style="width: 16px; height: 16px;"><path fill="currentColor" d="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-2 10h-4v4h-2v-4H7v-2h4V7h2v4h4v2z"/></svg>
        </div>
        <div class="stat-label" style="font-size: 0.7rem;">Average Order Value</div>
        <div class="stat-value" style="font-size: 1.65rem;">$@Model.AverageOrderValue.ToString("N2")</div>
    </div>

    <div class="stat-card" style="--card-accent: var(--purple); padding: 1.25rem 1.5rem;">
        <div class="stat-icon" style="width: 32px; height: 32px; margin-bottom: 0.5rem; background: var(--purple-dim); color: var(--purple);">
            <svg viewBox="0 0 24 24" style="width: 16px; height: 16px;"><path fill="currentColor" d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>
        </div>
        <div class="stat-label" style="font-size: 0.7rem;">Best Selling Product</div>
        <div class="stat-value" style="font-size: 1.25rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;" title="@Model.TopSellingProduct">@Model.TopSellingProduct</div>
    </div>

    <div class="stat-card" style="--card-accent: var(--emerald); padding: 1.25rem 1.5rem;">
        <div class="stat-icon" style="width: 32px; height: 32px; margin-bottom: 0.5rem; background: var(--emerald-dim); color: var(--emerald);">
            <svg viewBox="0 0 24 24" style="width: 16px; height: 16px;"><path fill="currentColor" d="M19 5h-2V3H7v2H5c-1.1 0-2 .9-2 2v3c0 2.21 1.79 4 4 4h2.2c.5 1.5 1.8 2.6 3.4 2.9V19H9v2h6v-2h-3.6v-2.1c1.6-.3 2.9-1.4 3.4-2.9H17c2.21 0 4-1.79 4-4V7c0-1.1-.9-2-2-2zM7 10H5V7h2v3zm12 0h-2V7h2v3z"/></svg>
        </div>
        <div class="stat-label" style="font-size: 0.7rem;">Top Buyer (Revenue)</div>
        <div class="stat-value" style="font-size: 1.25rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;" title="@Model.TopCustomerName ($@Model.TopCustomerRevenue.ToString("N2"))">
            @Model.TopCustomerName <span style="font-size: 0.95rem; color: var(--emerald); font-weight: 500;">($@Model.TopCustomerRevenue.ToString("N2"))</span>
        </div>
    </div>
</div>

<!-- ── SVG Sales Performance Chart ── -->
<div class="panel" style="margin-bottom: 2rem;">
    <div class="panel-header">
        <div>
            <div class="panel-title">Sales Performance</div>
            <div class="panel-subtitle">Revenue trend over the last 7 days</div>
        </div>
    </div>
    
    <div style="position: relative; width: 100%; height: 220px; padding: 0.5rem 0;">
        <svg viewBox="0 0 600 200" width="100%" height="100%" style="overflow: visible;">
            <defs>
                <!-- Area Gradient -->
                <linearGradient id="chart-area-grad" x1="0" y1="0" x2="0" y2="1">
                    <stop offset="0%" stop-color="var(--blue)" stop-opacity="0.32" />
                    <stop offset="100%" stop-color="var(--blue)" stop-opacity="0.0" />
                </linearGradient>
                
                <!-- Line Gradient -->
                <linearGradient id="chart-line-grad" x1="0" y1="0" x2="1" y2="0">
                    <stop offset="0%" stop-color="var(--blue)" />
                    <stop offset="100%" stop-color="var(--purple)" />
                </linearGradient>

                <!-- Grid Line Pattern -->
                <pattern id="grid" width="100" height="20" patternUnits="userSpaceOnUse">
                    <line x1="0" y1="0" x2="100" y2="0" stroke="rgba(255,255,255,0.03)" stroke-width="1" />
                </pattern>
            </defs>

            <!-- Grid Backdrop -->
            <rect x="35" y="30" width="530" height="140" fill="url(#grid)" />
            
            <!-- Horizontal Axes -->
            <line x1="35" y1="30" x2="565" y2="30" stroke="rgba(255,255,255,0.05)" stroke-width="1" />
            <line x1="35" y1="100" x2="565" y2="100" stroke="rgba(255,255,255,0.05)" stroke-width="1" />
            <line x1="35" y1="170" x2="565" y2="170" stroke="rgba(255,255,255,0.18)" stroke-width="1" />

            <!-- Y Axis helper values -->
            <text x="28" y="34" font-size="9" font-weight="600" fill="var(--text-3)" text-anchor="end">$@maxVal.ToString("F0")</text>
            <text x="28" y="104" font-size="9" font-weight="600" fill="var(--text-3)" text-anchor="end">$@((maxVal/2).ToString("F0"))</text>
            <text x="28" y="174" font-size="9" font-weight="600" fill="var(--text-3)" text-anchor="end">$0</text>

            <!-- Area under line -->
            <polygon points="@areaPoints" fill="url(#chart-area-grad)" />

            <!-- Line Path -->
            <polyline points="@chartPoints" fill="none" stroke="url(#chart-line-grad)" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />

            <!-- Interactive Dots & Tooltips -->
            @for (int i = 0; i < chartBars.Count; i++)
            {
                var bar = chartBars[i];
                <circle cx="@bar.x" cy="@bar.y" r="5" fill="#0c0f1d" stroke="var(--blue)" stroke-width="2.5" style="cursor: pointer;" />
                
                <!-- Tooltip values (hidden by default, shown on hover via CSS) -->
                <g class="chart-tooltip-group" style="opacity: 0; transition: opacity 0.2s ease;">
                    <rect x="@(bar.x - 45)" y="@(bar.y - 32)" width="90" height="22" rx="6" fill="#14192b" stroke="var(--border-hover)" stroke-width="1" />
                    @Html.Raw($"<text x='{bar.x}' y='{bar.y - 18}' fill='#fff' font-size='9.5' font-weight='700' text-anchor='middle'>${bar.amt.ToString("N2")}</text>")
                </g>

                <!-- X Axis Day Label -->
                @Html.Raw($"<text x='{bar.x}' y='192' font-size='9.5' font-weight='600' fill='var(--text-2)' text-anchor='middle'>{bar.dateVal}</text>")
            }
        </svg>
    </div>
</div>

<!-- ── Quick Actions ── -->
<div class="panel">
    <div class="panel-header">
        <div>
            <div class="panel-title">Quick Actions</div>
            <div class="panel-subtitle">Jump to the most common tasks</div>
        </div>
    </div>
    <div class="quick-actions">
        <a asp-controller="Order" asp-action="Create" class="action-card" id="qa-new-order">
            <div class="action-icon">
                <svg viewBox="0 0 24 24" fill="currentColor"><path d="M17 12h-5v5h5v-5zM16 1v2H8V1H6v2H5c-1.11 0-1.99.9-1.99 2L3 19c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2h-1V1h-2zm3 18H5V8h14v11z"/></svg>
            </div>
            <div>
                <div class="action-title">Place New Order</div>
                <div class="action-sub">Record a sales transaction</div>
            </div>
        </a>
        <a asp-controller="Product" asp-action="Create" class="action-card" id="qa-add-product">
            <div class="action-icon">
                <svg viewBox="0 0 24 24" fill="currentColor"><path d="M19 11h-6V5h-2v6H5v2h6v6h2v-6h6z"/></svg>
            </div>
            <div>
                <div class="action-title">Add Product</div>
                <div class="action-sub">Register new inventory item</div>
            </div>
        </a>
        <a asp-controller="Customer" asp-action="Create" class="action-card" id="qa-add-customer">
            <div class="action-icon">
                <svg viewBox="0 0 24 24" fill="currentColor"><path d="M15 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm-9-2V7H4v3H1v2h3v3h2v-3h3v-2H6zm9 4c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/></svg>
            </div>
            <div>
                <div class="action-title">Register Customer</div>
                <div class="action-sub">Add new customer profile</div>
            </div>
        </a>
    </div>
</div>

<!-- ── Bottom Grid: Recent Orders + Low Stock ── -->
<div class="dashboard-bottom-grid">

    <!-- Recent Orders -->
    <div class="panel" style="margin-bottom: 0;">
        <div class="panel-header">
            <div>
                <div class="panel-title">Recent Orders</div>
                <div class="panel-subtitle">Last 5 transactions</div>
            </div>
            <a asp-controller="Order" asp-action="Index" class="btn-secondary btn-sm" id="view-all-orders">View All</a>
        </div>
        <div class="table-responsive">
            <table class="custom-table">
                <thead>
                    <tr>
                        <th>Order</th>
                        <th>Customer</th>
                        <th>Product</th>
                        <th>Qty</th>
                        <th>Date</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.RecentOrders != null && Model.RecentOrders.Any())
                    {
                        @foreach (var order in Model.RecentOrders)
                        {
                            <tr>
                                <td><span class="table-id">#@order.Id</span></td>
                                <td class="table-name">@(order.Customer?.FullName ?? "N/A")</td>
                                <td class="table-mono">@(order.Product?.Name ?? "N/A")</td>
                                <td>
                                    <span class="badge badge-blue">@order.Quantity</span>
                                </td>
                                <td class="table-mono">@order.OrderDate.ToString("MMM dd, HH:mm")</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5">
                                <div class="empty-state">
                                    <div class="empty-state-icon">📋</div>
                                    <div class="empty-state-text">No orders placed yet.</div>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Low Stock Alert -->
    <div class="panel" style="margin-bottom: 0;">
        <div class="panel-header">
            <div>
                <div class="panel-title">Low Stock Alert</div>
                <div class="panel-subtitle">Products below 10 units</div>
            </div>
        </div>
        <div style="display: flex; flex-direction: column; gap: 0.75rem;">
            @if (Model.LowStockProducts != null && Model.LowStockProducts.Any())
            {
                @foreach (var p in Model.LowStockProducts)
                {
                    <div class="low-stock-item">
                        <div>
                            <div class="low-stock-name">@p.Name</div>
                            <div class="low-stock-price">$@p.Price.ToString("N2") each</div>
                        </div>
                        <span class="badge badge-danger">@p.Stock left</span>
                    </div>
                }
                <a asp-controller="Product" asp-action="Index" class="btn-secondary btn-sm" style="text-align: center; justify-content: center; margin-top: 0.5rem;">
                    Manage Inventory
                </a>
            }
            else
            {
                <div class="stock-ok">
                    <div class="stock-ok-icon">✓</div>
                    <div class="stock-ok-title">All Good!</div>
                    <div class="stock-ok-sub">All products have sufficient stock levels.</div>
                </div>
            }
        </div>
    </div>
</div>
