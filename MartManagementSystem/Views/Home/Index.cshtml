@model MartManagementSystem.Services.DashboardDto
@{
    ViewData["Title"] = "Dashboard";
}

<div class="header-wrapper">
    <div>
        <h1 class="page-title">Dashboard Overview</h1>
        <p class="page-subtitle">Your mart's business snapshot — updated in real time.</p>
    </div>
</div>

<!-- ── Stats Cards ── -->
<div class="stats-grid">
    <div class="stat-card" style="--card-accent: var(--blue);">
        <div class="stat-icon">
            <svg viewBox="0 0 24 24"><path d="M11.8 10.9c-2.27-.59-3-1.2-3-2.15 0-1.09 1.01-1.85 2.7-1.85 1.78 0 2.44.85 2.5 2.1h2.21c-.07-1.72-1.12-3.3-3.21-3.81V3h-3v2.16c-1.94.42-3.5 1.68-3.5 3.61 0 2.31 1.91 3.46 4.7 4.13 2.5.6 3 1.48 3 2.41 0 .69-.49 1.79-2.7 1.79-2.06 0-2.87-.92-2.98-2.1h-2.2c.12 2.19 1.76 3.42 3.68 3.83V21h3v-2.15c1.95-.37 3.5-1.5 3.5-3.55 0-2.84-2.43-3.81-4.7-4.4z"/></svg>
        </div>
        <div class="stat-label">Total Revenue</div>
        <div class="stat-value">$@Model.TotalSales.ToString("N2")</div>
    </div>

    <div class="stat-card" style="--card-accent: var(--purple);">
        <div class="stat-icon" style="background: var(--purple-dim); color: var(--purple);">
            <svg viewBox="0 0 24 24"><path d="M19 15v-3h-2v3h-3v2h3v3h2v-3h3v-2h-3zM11 5H4v2h7V5zm0 4H4v2h7V9zm-7 6h5v-2H4v2zm0 4h5v-2H4v2zm9-12h7v2h-7V7zm0 4h7v2h-7v-2z"/></svg>
        </div>
        <div class="stat-label">Total Orders</div>
        <div class="stat-value">@Model.TotalOrders</div>
    </div>

    <div class="stat-card" style="--card-accent: var(--emerald);">
        <div class="stat-icon" style="background: var(--emerald-dim); color: var(--emerald);">
            <svg viewBox="0 0 24 24"><path d="M21.822 7.431A1 1 0 0 0 21 7H3a1 1 0 0 0-.822.431 1 1 0 0 0 .025 1.066l2 3A1 1 0 0 0 5 12h14a1 1 0 0 0 .797-.393l2-3a1 1 0 0 0 .025-1.076zM5.586 10l-1.333-2h15.494l-1.333 2H5.586zM2 14h20v2H2zm0 4h20v2H2z"/></svg>
        </div>
        <div class="stat-label">Active Products</div>
        <div class="stat-value">@Model.TotalProducts</div>
    </div>

    <div class="stat-card" style="--card-accent: var(--amber);">
        <div class="stat-icon" style="background: var(--amber-dim); color: var(--amber);">
            <svg viewBox="0 0 24 24"><path d="M12 2C6.579 2 2 6.579 2 12s4.579 10 10 10 10-4.579 10-10S17.421 2 12 2zm0 3c1.93 0 3.5 1.57 3.5 3.5S13.93 12 12 12s-3.5-1.57-3.5-3.5S10.07 5 12 5zm0 14c-3.86 0-7-2.69-7-6 0-.552.448-1 1-1h12c.552 0 1 .448 1 1 0 3.31-3.14 6-7 6z"/></svg>
        </div>
        <div class="stat-label">Customers</div>
        <div class="stat-value">@Model.TotalCustomers</div>
    </div>
</div>

<!-- ── Quick Actions ── -->
<div class="panel">
    <div class="panel-header">
        <div>
            <div class="panel-title">Quick Actions</div>
            <div class="panel-subtitle">Jump to the most common tasks</div>
        </div>
    </div>
    <div class="quick-actions">
        <a asp-controller="Order" asp-action="Create" class="action-card" id="qa-new-order">
            <div class="action-icon">
                <svg viewBox="0 0 24 24" fill="currentColor"><path d="M17 12h-5v5h5v-5zM16 1v2H8V1H6v2H5c-1.11 0-1.99.9-1.99 2L3 19c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2h-1V1h-2zm3 18H5V8h14v11z"/></svg>
            </div>
            <div>
                <div class="action-title">Place New Order</div>
                <div class="action-sub">Record a sales transaction</div>
            </div>
        </a>
        <a asp-controller="Product" asp-action="Create" class="action-card" id="qa-add-product">
            <div class="action-icon">
                <svg viewBox="0 0 24 24" fill="currentColor"><path d="M19 11h-6V5h-2v6H5v2h6v6h2v-6h6z"/></svg>
            </div>
            <div>
                <div class="action-title">Add Product</div>
                <div class="action-sub">Register new inventory item</div>
            </div>
        </a>
        <a asp-controller="Customer" asp-action="Create" class="action-card" id="qa-add-customer">
            <div class="action-icon">
                <svg viewBox="0 0 24 24" fill="currentColor"><path d="M15 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm-9-2V7H4v3H1v2h3v3h2v-3h3v-2H6zm9 4c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/></svg>
            </div>
            <div>
                <div class="action-title">Register Customer</div>
                <div class="action-sub">Add new customer profile</div>
            </div>
        </a>
    </div>
</div>

<!-- ── Bottom Grid: Recent Orders + Low Stock ── -->
<div style="display: grid; grid-template-columns: 3fr 2fr; gap: 1.5rem; align-items: start;">

    <!-- Recent Orders -->
    <div class="panel" style="margin-bottom: 0;">
        <div class="panel-header">
            <div>
                <div class="panel-title">Recent Orders</div>
                <div class="panel-subtitle">Last 5 transactions</div>
            </div>
            <a asp-controller="Order" asp-action="Index" class="btn-secondary btn-sm" id="view-all-orders">View All</a>
        </div>
        <div class="table-responsive">
            <table class="custom-table">
                <thead>
                    <tr>
                        <th>Order</th>
                        <th>Customer</th>
                        <th>Product</th>
                        <th>Qty</th>
                        <th>Date</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.RecentOrders != null && Model.RecentOrders.Any())
                    {
                        @foreach (var order in Model.RecentOrders)
                        {
                            <tr>
                                <td><span class="table-id">#@order.Id</span></td>
                                <td class="table-name">@(order.Customer?.FullName ?? "N/A")</td>
                                <td class="table-mono">@(order.Product?.Name ?? "N/A")</td>
                                <td>
                                    <span class="badge badge-blue">@order.Quantity</span>
                                </td>
                                <td class="table-mono">@order.OrderDate.ToString("MMM dd, HH:mm")</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5">
                                <div class="empty-state">
                                    <div class="empty-state-icon">📋</div>
                                    <div class="empty-state-text">No orders placed yet.</div>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Low Stock Alert -->
    <div class="panel" style="margin-bottom: 0;">
        <div class="panel-header">
            <div>
                <div class="panel-title">Low Stock Alert</div>
                <div class="panel-subtitle">Products below 10 units</div>
            </div>
        </div>
        <div style="display: flex; flex-direction: column; gap: 0.75rem;">
            @if (Model.LowStockProducts != null && Model.LowStockProducts.Any())
            {
                @foreach (var p in Model.LowStockProducts)
                {
                    <div class="low-stock-item">
                        <div>
                            <div class="low-stock-name">@p.Name</div>
                            <div class="low-stock-price">$@p.Price.ToString("N2") each</div>
                        </div>
                        <span class="badge badge-danger">@p.Stock left</span>
                    </div>
                }
                <a asp-controller="Product" asp-action="Index" class="btn-secondary btn-sm" style="text-align: center; justify-content: center; margin-top: 0.5rem;">
                    Manage Inventory
                </a>
            }
            else
            {
                <div class="stock-ok">
                    <div class="stock-ok-icon">✓</div>
                    <div class="stock-ok-title">All Good!</div>
                    <div class="stock-ok-sub">All products have sufficient stock levels.</div>
                </div>
            }
        </div>
    </div>
</div>
