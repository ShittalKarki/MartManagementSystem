@model MartManagementSystem.Services.DashboardDto
@{
    ViewData["Title"] = "Dashboard";
}

<div class="header-wrapper">
    <div>
        <h1 class="page-title">Dashboard Overview</h1>
        <p style="color: var(--text-secondary); margin-top: 0.25rem;">Welcome to the Mart Management System. Here is your business snapshot.</p>
    </div>
</div>

<!-- Stats Grid -->
<div class="stats-grid">
    <div class="stat-card" style="--card-accent: var(--accent-blue);">
        <div>
            <div class="stat-label">Total Revenue</div>
            <div class="stat-value">$@Model.TotalSales.ToString("N2")</div>
        </div>
    </div>
    <div class="stat-card" style="--card-accent: var(--accent-purple);">
        <div>
            <div class="stat-label">Total Orders</div>
            <div class="stat-value">@Model.TotalOrders</div>
        </div>
    </div>
    <div class="stat-card" style="--card-accent: var(--accent-emerald);">
        <div>
            <div class="stat-label">Products Active</div>
            <div class="stat-value">@Model.TotalProducts</div>
        </div>
    </div>
    <div class="stat-card" style="--card-accent: var(--accent-amber);">
        <div>
            <div class="stat-label">Registered Customers</div>
            <div class="stat-value">@Model.TotalCustomers</div>
        </div>
    </div>
</div>

<!-- Quick Actions -->
<div class="panel">
    <div class="panel-header">
        <h2 class="panel-title">Quick Actions</h2>
    </div>
    <div class="quick-actions">
        <a href="@Url.Action("Create", "Order")" class="action-card">
            <div class="action-icon">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 5H4v2h7V5zm0 4H4v2h7V9zm-7 6h5v-2H4v2zm0 4h5v-2H4v2zm9-12h7v2h-7V7zm0 4h7v2h-7v-2z"></path></svg>
            </div>
            <div>
                <div class="action-title">Place New Order</div>
            </div>
        </a>
        <a href="@Url.Action("Create", "Product")" class="action-card">
            <div class="action-icon">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
            </div>
            <div>
                <div class="action-title">Add New Product</div>
            </div>
        </a>
        <a href="@Url.Action("Create", "Customer")" class="action-card">
            <div class="action-icon">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><line x1="19" y1="8" x2="19" y2="14"></line><line x1="16" y1="11" x2="22" y2="11"></line></svg>
            </div>
            <div>
                <div class="action-title">Register Customer</div>
            </div>
        </a>
    </div>
</div>

<!-- Low Stock & Recent Orders Sections -->
<div style="display: grid; grid-template-columns: 2fr 1fr; gap: 2rem; align-items: start;">
    
    <!-- Recent Orders Panel -->
    <div class="panel" style="margin-bottom: 0;">
        <div class="panel-header">
            <h2 class="panel-title">Recent Orders</h2>
            <a href="@Url.Action("Index", "Order")" class="btn-secondary" style="padding: 0.5rem 1rem; font-size: 0.85rem;">View All</a>
        </div>
        <div class="table-responsive">
            <table class="custom-table">
                <thead>
                    <tr>
                        <th>Order ID</th>
                        <th>Customer</th>
                        <th>Product</th>
                        <th>Qty</th>
                        <th>Date</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.RecentOrders != null && Model.RecentOrders.Any())
                    {
                        @foreach (var order in Model.RecentOrders)
                        {
                            <tr>
                                <td>#@order.Id</td>
                                <td>@(order.Customer?.FullName ?? "N/A")</td>
                                <td>@(order.Product?.Name ?? "N/A")</td>
                                <td>@order.Quantity</td>
                                <td>@order.OrderDate.ToString("MM/dd/yyyy HH:mm")</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" style="text-align: center; color: var(--text-muted); padding: 2rem;">No recent orders found.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Low Stock Alerts Panel -->
    <div class="panel" style="margin-bottom: 0;">
        <div class="panel-header">
            <h2 class="panel-title">Low Stock Alert</h2>
        </div>
        <div style="display: flex; flex-direction: column; gap: 1rem;">
            @if (Model.LowStockProducts != null && Model.LowStockProducts.Any())
            {
                @foreach (var product in Model.LowStockProducts)
                {
                    <div style="display: flex; justify-content: space-between; align-items: center; padding: 0.75rem 1rem; background: rgba(244, 63, 94, 0.05); border: 1px solid rgba(244, 63, 94, 0.15); border-radius: 12px;">
                        <div>
                            <div style="font-weight: 600; font-size: 0.95rem;">@product.Name</div>
                            <div style="font-size: 0.8rem; color: var(--text-secondary);">Unit Price: $@product.Price.ToString("N2")</div>
                        </div>
                        <span class="badge badge-danger">@product.Stock left</span>
                    </div>
                }
            }
            else
            {
                <div style="text-align: center; color: var(--accent-emerald); background: rgba(16, 185, 129, 0.05); border: 1px solid rgba(16, 185, 129, 0.15); padding: 1.5rem; border-radius: 12px;">
                    <div style="font-weight: 600; margin-bottom: 0.25rem;">✓ Status Clear</div>
                    <div style="font-size: 0.85rem; color: var(--text-secondary);">All products have sufficient stock levels.</div>
                </div>
            }
        </div>
    </div>
</div>
