@model IEnumerable<MartManagementSystem.Models.Customer>
@{
    ViewData["Title"] = "Customers List";
}

<div class="header-wrapper">
    <div>
        <h1 class="page-title">Customers Directory</h1>
        <p style="color: var(--text-secondary); margin-top: 0.25rem;">Manage buyer registries, details, and emails.</p>
    </div>
    <a href="@Url.Action("Create")" class="btn-primary">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><line x1="19" y1="11" x2="22" y2="11"></line><line x1="19" y1="8" x2="19" y2="14"></line></svg>
        Register Customer
    </a>
</div>

<div class="panel">
    <div class="table-responsive">
        <table class="custom-table">
            <thead>
                <tr>
                    <th>Customer ID</th>
                    <th>Full Name</th>
                    <th>Email Address</th>
                    <th style="text-align: right;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    @foreach (var c in Model)
                    {
                        <tr>
                            <td>#@c.Id</td>
                            <td style="font-weight: 600;">@c.FullName</td>
                            <td>@c.Email</td>
                            <td style="text-align: right;">
                                <div style="display: inline-flex; gap: 0.5rem; justify-content: flex-end; align-items: center;">
                                    <a href="@Url.Action("Edit", new { id = c.Id })" class="btn-secondary" style="padding: 0.4rem 0.8rem; font-size: 0.85rem; border-radius: 8px;">
                                        Edit
                                    </a>
                                    <form asp-action="Delete" asp-route-id="@c.Id" method="post" onsubmit="return confirm('Are you sure you want to delete this customer?');" style="display:inline;">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn-secondary" style="padding: 0.4rem 0.8rem; font-size: 0.85rem; border-radius: 8px; color: var(--accent-rose); border-color: rgba(244, 63, 94, 0.2); background: rgba(244, 63, 94, 0.02);">
                                            Delete
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="4" style="text-align: center; color: var(--text-muted); padding: 3rem;">
                            No customers registered.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
