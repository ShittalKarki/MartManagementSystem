@model MartManagementSystem.Models.Customer
@{
    ViewData["Title"] = "Register Customer";
}

<div class="header-wrapper">
    <div>
        <h1 class="page-title">Register Customer</h1>
        <p style="color: var(--text-secondary); margin-top: 0.25rem;">Register a customer profile for sales tracking and ordering.</p>
    </div>
    <a href="@Url.Action("Index")" class="btn-secondary">Back to List</a>
</div>

<div class="panel form-panel">
    <form asp-action="Create" method="post">
        @Html.AntiForgeryToken()
        
        <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>

        <div class="form-group">
            <label asp-for="FullName" class="form-label">Full Name</label>
            <input asp-for="FullName" class="form-control" placeholder="e.g., Alice Johnson" required />
            <span asp-validation-for="FullName" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="Email" class="form-label">Email Address</label>
            <input asp-for="Email" class="form-control" type="email" placeholder="e.g., alice@example.com" required />
            <span asp-validation-for="Email" class="text-danger"></span>
        </div>

        <div class="form-actions">
            <a href="@Url.Action("Index")" class="btn-secondary">Cancel</a>
            <button type="submit" class="btn-primary">Register</button>
        </div>
    </form>
</div>
