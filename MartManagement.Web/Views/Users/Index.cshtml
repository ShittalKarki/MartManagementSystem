@* MartMS *@
@model IEnumerable<AppUser>
@{ ViewData["Title"] = "Users"; }
<div class="page-header">
    <h2>User Management</h2>
    <a asp-action="Create" class="btn btn-primary">Add User</a>
</div>
<div class="card table-card">
    <table class="table table-hover">
        <thead><tr><th>Username</th><th>Name</th><th>Email</th><th>Role</th><th>Status</th><th></th></tr></thead>
        <tbody>
        @foreach (var u in Model)
        {
            <tr>
                <td>@u.Username</td>
                <td>@u.FullName</td>
                <td>@u.Email</td>
                <td>@u.Role.Name</td>
                <td><span class="badge bg-@(u.IsActive ? "success" : "secondary")">@(u.IsActive ? "Active" : "Inactive")</span></td>
                <td><a asp-action="Edit" asp-route-id="@u.Id" class="btn btn-sm btn-outline-primary">Edit</a></td>
            </tr>
        }
        </tbody>
    </table>
</div>
