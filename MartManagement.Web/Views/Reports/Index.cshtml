@* MartMS *@
@model SalesReportViewModel
@{
    ViewData["Title"] = "Reports";
    ViewData["PageTitle"] = "Sales analytics";
    ViewData["PageSubtitle"] = $"{Model.From:dd MMM yyyy} – {Model.To:dd MMM yyyy}";
    ViewData["PageActions"] = $"<a href=\"{Url.Action("ExportSales", new { from = ViewBag.From, to = ViewBag.To })}\" class=\"btn btn-outline-success\"><i class=\"bi bi-file-earmark-excel me-1\"></i>Export Excel</a>";
}
<partial name="_PageHeader" />

<div class="filter-bar">
    <form method="get" class="row g-2 align-items-end">
        <div class="col-md-3">
            <label class="form-label small text-muted">From</label>
            <input type="date" name="from" value="@ViewBag.From" class="form-control" />
        </div>
        <div class="col-md-3">
            <label class="form-label small text-muted">To</label>
            <input type="date" name="to" value="@ViewBag.To" class="form-control" />
        </div>
        <div class="col-md-2">
            <button class="btn btn-primary w-100">Update</button>
        </div>
        <div class="col-md-2">
            <a asp-action="Products" class="btn btn-light w-100">Stock report</a>
        </div>
    </form>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-6">
        <div class="card kpi-card kpi-primary">
            <div class="kpi-icon"><i class="bi bi-cash-stack"></i></div>
            <div class="kpi-value">Rs. @Model.TotalRevenue.ToString("N2")</div>
            <div class="kpi-label">Total revenue (selected period)</div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card kpi-card kpi-accent">
            <div class="kpi-icon"><i class="bi bi-receipt"></i></div>
            <div class="kpi-value">@Model.TotalTransactions</div>
            <div class="kpi-label">Transactions</div>
        </div>
    </div>
</div>

<div class="card chart-card">
    <div class="card-header">Daily revenue</div>
    <div class="card-body">
        @if (!Model.DailyBreakdown.Any())
        {
            <p class="text-muted text-center py-4 mb-0">No sales in this date range.</p>
        }
        else
        {
            <canvas id="reportChart" height="100"></canvas>
        }
    </div>
</div>

@section Scripts {
@if (Model.DailyBreakdown.Any())
{
<script>
    new Chart(document.getElementById('reportChart'), {
        type: 'bar',
        data: {
            labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.DailyBreakdown.Select(d => d.Label))),
            datasets: [{
                data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.DailyBreakdown.Select(d => d.Value))),
                backgroundColor: 'rgba(13,148,136,0.8)',
                borderRadius: 8
            }]
        },
        options: { responsive: true, plugins: { legend: { display: false } }, scales: { y: { beginAtZero: true } } }
    });
</script>
}
}
