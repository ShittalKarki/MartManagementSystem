@* MartMS *@
@model IEnumerable<ActivityLog>
@{ ViewData["Title"] = "Activity Logs"; }
<div class="page-header"><h2>Activity Logs</h2></div>
<div class="card table-card">
    <table class="table table-sm table-hover">
        <thead><tr><th>When</th><th>User</th><th>Action</th><th>Entity</th><th>Details</th></tr></thead>
        <tbody>
        @foreach (var log in Model)
        {
            <tr>
                <td>@log.CreatedAt.ToLocalTime().ToString("g")</td>
                <td>@(log.User?.Username ?? "System")</td>
                <td>@log.Action</td>
                <td>@log.EntityName</td>
                <td>@log.Details</td>
            </tr>
        }
        </tbody>
    </table>
</div>
