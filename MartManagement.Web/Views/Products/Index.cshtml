@* MartMS *@
@model ProductListViewModel
@{
    var isAdmin = User.IsInRole("Admin");
    ViewData["Title"] = "Products";
    ViewData["PageTitle"] = "Products";
    ViewData["PageSubtitle"] = $"{Model.TotalCount} items in catalog";
    if (isAdmin)
        ViewData["PageActions"] = $"<a href=\"{Url.Action("Create")}\" class=\"btn btn-primary\"><i class=\"bi bi-plus-lg me-1\"></i>Add product</a>";
}
<partial name="_PageHeader" />

<div class="filter-bar">
    <form method="get" class="row g-2 align-items-end">
        <div class="col-md-5">
            <label class="form-label small text-muted">Search</label>
            <input name="search" value="@Model.Search" class="form-control" placeholder="Name, SKU, or barcode" />
        </div>
        <div class="col-md-4">
            <label class="form-label small text-muted">Category</label>
            <select name="categoryId" class="form-select" asp-items="Model.Categories">
                <option value="">All categories</option>
            </select>
        </div>
        <div class="col-md-3 d-flex gap-2">
            <button type="submit" class="btn btn-primary flex-grow-1"><i class="bi bi-funnel me-1"></i>Apply</button>
            <a asp-action="Index" class="btn btn-light">Reset</a>
        </div>
    </form>
</div>

<div class="card">
    <div class="table-responsive">
        <table class="table table-modern mb-0">
            <thead>
                <tr>
                    <th></th>
                    <th>SKU</th>
                    <th>Product</th>
                    <th>Category</th>
                    <th>Stock</th>
                    <th class="text-end">Price</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
            @if (!Model.Products.Any())
            {
                <tr><td colspan="7">
                    <div class="empty-state py-4">
                        <div class="empty-state-icon"><i class="bi bi-box-seam"></i></div>
                        <h5>No products yet</h5>
                        <p class="text-muted">Add your first product to start tracking inventory.</p>
                        @if (isAdmin)
                        {
                            <a asp-action="Create" class="btn btn-primary btn-sm">Add product</a>
                        }
                    </div>
                </td></tr>
            }
            @foreach (var p in Model.Products)
            {
                <tr>
                    <td style="width:48px">
                        @if (p.ImagePath != null)
                        {
                            <img src="@p.ImagePath" alt="" width="40" height="40" class="rounded object-fit-cover" />
                        }
                        else
                        {
                            <span class="user-avatar" style="width:40px;height:40px;font-size:.75rem">@(p.Name.Length > 0 ? p.Name[0].ToString().ToUpper() : "?")</span>
                        }
                    </td>
                    <td><code class="small">@p.Sku</code></td>
                    <td class="fw-semibold">@p.Name</td>
                    <td><span class="badge text-bg-light">@p.Category?.Name</span></td>
                    <td class="@(p.StockQuantity <= p.ReorderLevel ? "low-stock" : "")">@p.StockQuantity @p.Unit</td>
                    <td class="text-end">Rs. @p.SellingPrice.ToString("N2")</td>
                    <td class="text-end">
                        <a asp-action="Details" asp-route-id="@p.Id" class="btn btn-sm btn-light">View</a>
                        @if (isAdmin)
                        {
                            <a asp-action="Edit" asp-route-id="@p.Id" class="btn btn-sm btn-outline-primary">Edit</a>
                        }
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>

@if (Model.TotalCount > Model.PageSize)
{
    <nav class="mt-3">
        <ul class="pagination justify-content-center">
            @{
                var totalPages = (int)Math.Ceiling(Model.TotalCount / (double)Model.PageSize);
            }
            @for (var i = 1; i <= totalPages; i++)
            {
                <li class="page-item @(i == Model.Page ? "active" : "")">
                    <a class="page-link" asp-route-page="@i" asp-route-search="@Model.Search" asp-route-categoryId="@Model.CategoryId">@i</a>
                </li>
            }
        </ul>
    </nav>
}
