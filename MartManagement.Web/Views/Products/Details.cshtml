@* MartMS *@
@model Product
@{ ViewData["Title"] = Model.Name; }
<div class="page-header">
    <h2>@Model.Name</h2>
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Edit</a>
</div>
<div class="card p-4">
    <div class="row">
        @if (Model.ImagePath != null) { <div class="col-md-3"><img src="@Model.ImagePath" class="img-fluid rounded" alt="@Model.Name" /></div> }
        <div class="col">
            <dl class="row">
                <dt class="col-sm-3">SKU</dt><dd class="col-sm-9">@Model.Sku</dd>
                <dt class="col-sm-3">Category</dt><dd class="col-sm-9">@Model.Category?.Name</dd>
                <dt class="col-sm-3">Barcode</dt><dd class="col-sm-9">@Model.Barcode</dd>
                <dt class="col-sm-3">Stock</dt><dd class="col-sm-9">@Model.StockQuantity @Model.Unit</dd>
                <dt class="col-sm-3">Prices</dt><dd class="col-sm-9">Buy Rs. @Model.PurchasePrice / Sell Rs. @Model.SellingPrice</dd>
                <dt class="col-sm-3">Description</dt><dd class="col-sm-9">@Model.Description</dd>
            </dl>
        </div>
    </div>
</div>
