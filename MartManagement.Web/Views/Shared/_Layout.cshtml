@* MartMS *@
@{
    var title = ViewData["Title"] as string ?? "Mart Management";
    var isAdmin = User.IsInRole("Admin");
    var isStaff = User.IsInRole("Staff");
    var userName = User.FindFirst(System.Security.Claims.ClaimTypes.GivenName)?.Value ?? "User";
    var initial = string.IsNullOrEmpty(userName) ? "U" : userName[..1].ToUpper();
}
<!DOCTYPE html>
<html lang="en" data-bs-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@title - MartMS</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="app-authenticated">
    <div class="sidebar-overlay" id="sidebarOverlay" aria-hidden="true"></div>
    <div class="app-shell" id="appShell">
        <aside class="sidebar" id="sidebar" aria-label="Main navigation">
            <div class="brand">
                <div class="brand-icon"><i class="bi bi-shop-window"></i></div>
                <div class="brand-text">
                    <strong>MartMS</strong>
                    <small>@(isAdmin ? "Admin" : "Staff") Panel</small>
                </div>
            </div>
            <nav class="nav flex-column flex-nowrap sidebar-nav">
                <a class="nav-link" asp-controller="Dashboard" asp-action="Index"><i class="bi bi-grid-1x2-fill"></i><span class="nav-text">Dashboard</span></a>

                @if (isStaff)
                {
                    <span class="nav-section-label">Daily work</span>
                    <a class="nav-link" asp-controller="Sales" asp-action="Create"><i class="bi bi-cart-check"></i><span class="nav-text">New sale</span></a>
                    <a class="nav-link" asp-controller="Sales" asp-action="Index"><i class="bi bi-receipt"></i><span class="nav-text">Sales list</span></a>
                    <a class="nav-link" asp-controller="Products" asp-action="Index"><i class="bi bi-box-seam"></i><span class="nav-text">Products</span></a>
                    <a class="nav-link" asp-controller="Inventory" asp-action="Index"><i class="bi bi-boxes"></i><span class="nav-text">Stock</span></a>
                    <a class="nav-link" asp-controller="Inventory" asp-action="Adjust"><i class="bi bi-arrow-left-right"></i><span class="nav-text">Update stock</span></a>
                }
                else
                {
                    <span class="nav-section-label">Store</span>
                    <a class="nav-link" asp-controller="Products" asp-action="Index"><i class="bi bi-box-seam"></i><span class="nav-text">Products</span></a>
                    <a class="nav-link" asp-controller="Categories" asp-action="Index"><i class="bi bi-tags"></i><span class="nav-text">Categories</span></a>
                    <a class="nav-link" asp-controller="Inventory" asp-action="Index"><i class="bi bi-boxes"></i><span class="nav-text">Inventory</span></a>
                    <span class="nav-section-label">Sales</span>
                    <a class="nav-link" asp-controller="Sales" asp-action="Create"><i class="bi bi-cart-check"></i><span class="nav-text">New sale</span></a>
                    <a class="nav-link" asp-controller="Sales" asp-action="Index"><i class="bi bi-receipt"></i><span class="nav-text">Sales history</span></a>
                    <span class="nav-section-label">Purchasing</span>
                    <a class="nav-link" asp-controller="Purchases" asp-action="Index"><i class="bi bi-bag-plus"></i><span class="nav-text">Purchases</span></a>
                    <a class="nav-link" asp-controller="Suppliers" asp-action="Index"><i class="bi bi-truck"></i><span class="nav-text">Suppliers</span></a>
                    <span class="nav-section-label">More</span>
                    <a class="nav-link" asp-controller="Customers" asp-action="Index"><i class="bi bi-people"></i><span class="nav-text">Customers</span></a>
                    <a class="nav-link" asp-controller="Reports" asp-action="Index"><i class="bi bi-bar-chart-line"></i><span class="nav-text">Reports</span></a>
                    <a class="nav-link" asp-controller="Users" asp-action="Index"><i class="bi bi-shield-lock"></i><span class="nav-text">Users</span></a>
                }
            </nav>
            <div class="sidebar-footer">MartMS · Retail Console</div>
        </aside>
        <div class="main-panel">
            <header class="topbar">
                <button type="button" class="btn-icon d-lg-none" id="sidebarToggle" aria-label="Menu"><i class="bi bi-list"></i></button>
                <button type="button" class="btn-icon d-none d-lg-inline-flex" id="sidebarCollapse" aria-label="Collapse"><i class="bi bi-layout-sidebar"></i></button>
                <div class="ms-auto d-flex align-items-center gap-2">
                    @if (isAdmin)
                    {
                        @await Component.InvokeAsync("NotificationBell")
                    }
                    <div class="dropdown user-dropdown">
                        <button class="dropdown-toggle" type="button" data-bs-toggle="dropdown">
                            <span class="user-avatar">@initial</span>
                            <span class="d-none d-md-inline">@userName</span>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end shadow">
                            <li><a class="dropdown-item" asp-controller="Account" asp-action="Profile"><i class="bi bi-person me-2"></i>Profile</a></li>
                            <li><hr class="dropdown-divider" /></li>
                            <li>
                                <form asp-controller="Account" asp-action="Logout" method="post">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="dropdown-item text-danger"><i class="bi bi-box-arrow-right me-2"></i>Logout</button>
                                </form>
                            </li>
                        </ul>
                    </div>
                </div>
            </header>
            <main class="content-area">
                @await Html.PartialAsync("_Alerts")
                @RenderBody()
            </main>
        </div>
    </div>
    @await Html.PartialAsync("_DeleteModal")
    @await Html.PartialAsync("_ToastContainer")
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
