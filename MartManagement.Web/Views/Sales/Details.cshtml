@* MartMS *@
@model Sale
@{ ViewData["Title"] = Model.InvoiceNumber; }
<div class="page-header">
    <h2>@Model.InvoiceNumber</h2>
    <a asp-action="Invoice" asp-route-id="@Model.Id" class="btn btn-primary">Print Invoice</a>
</div>
<div class="card p-4">
    <p><strong>Customer:</strong> @(Model.Customer?.Name ?? "Walk-in")</p>
    <table class="table">
        <thead><tr><th>Product</th><th>Qty</th><th>Total</th></tr></thead>
        <tbody>
        @foreach (var line in Model.Items)
        {
            <tr><td>@line.Product.Name</td><td>@line.Quantity</td><td>Rs. @line.LineTotal.ToString("N2")</td></tr>
        }
        </tbody>
    </table>
    <p class="text-end fw-bold">Grand Total: Rs. @Model.TotalAmount.ToString("N2")</p>
</div>
