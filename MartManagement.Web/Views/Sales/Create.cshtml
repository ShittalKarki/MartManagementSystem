@* MartMS *@
@model SaleCreateViewModel
@{ ViewData["Title"] = "New Sale"; }
<div class="page-header"><h2>New Sale / Invoice</h2></div>
<div class="card p-4">
    <form asp-action="Create" method="post" id="saleForm">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
        <div class="row g-3 mb-3">
            <div class="col-md-4">
                <label class="form-label">Customer</label>
                <select asp-for="CustomerId" asp-items="Model.Customers" class="form-select">
                    <option value="">Walk-in</option>
                </select>
            </div>
            <div class="col-md-3">
                <label asp-for="DiscountAmount" class="form-label">Bill Discount (Rs.)</label>
                <input asp-for="DiscountAmount" class="form-control" value="0" />
            </div>
            <div class="col-md-5">
                <label asp-for="Notes" class="form-label">Notes</label>
                <input asp-for="Notes" class="form-control" />
            </div>
        </div>
        <div id="lineItems">
            @for (var i = 0; i < Model.Lines.Count; i++)
            {
                <div class="row g-2 line-row mb-2 align-items-end">
                    <div class="col-md-4">
                        <label class="form-label">Product</label>
                        <select asp-for="Lines[i].ProductId" asp-items="Model.Products" class="form-select product-select"></select>
                    </div>
                    <div class="col-md-2"><label class="form-label">Qty</label><input asp-for="Lines[i].Quantity" class="form-control qty-input" type="number" min="1" /></div>
                    <div class="col-md-2"><label class="form-label">Price</label><input asp-for="Lines[i].UnitPrice" class="form-control price-input" step="0.01" /></div>
                    <div class="col-md-2"><label class="form-label">Disc %</label><input asp-for="Lines[i].DiscountPercent" class="form-control" step="0.01" /></div>
                    <div class="col-md-1"><label class="form-label">Tax%</label><input asp-for="Lines[i].TaxPercent" class="form-control tax-input" /></div>
                    <div class="col-md-1"><button type="button" class="btn btn-outline-danger w-100" onclick="mart.removeLine(this)">×</button></div>
                </div>
            }
        </div>
        <button type="button" class="btn btn-outline-secondary btn-sm mb-3" id="addLine">+ Add line</button>
        <div>
            <button type="submit" class="btn btn-primary">Complete Sale</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
        </div>
    </form>
</div>
@section Scripts {
<partial name="_ValidationScriptsPartial" />
<script>
    const productOptions = `@Html.Raw(string.Join("", Model.Products.Select(p => $"<option value='{p.Value}'>{p.Text}</option>")))`;
    document.getElementById('addLine').addEventListener('click', () => {
        const i = document.querySelectorAll('#lineItems .line-row').length;
        document.getElementById('lineItems').insertAdjacentHTML('beforeend', `
            <div class="row g-2 line-row mb-2 align-items-end">
                <div class="col-md-4"><label class="form-label">Product</label><select name="Lines[${i}].ProductId" class="form-select product-select">${productOptions}</select></div>
                <div class="col-md-2"><label class="form-label">Qty</label><input name="Lines[${i}].Quantity" class="form-control qty-input" type="number" min="1" value="1" /></div>
                <div class="col-md-2"><label class="form-label">Price</label><input name="Lines[${i}].UnitPrice" class="form-control price-input" step="0.01" /></div>
                <div class="col-md-2"><label class="form-label">Disc %</label><input name="Lines[${i}].DiscountPercent" class="form-control" value="0" /></div>
                <div class="col-md-1"><label class="form-label">Tax%</label><input name="Lines[${i}].TaxPercent" class="form-control tax-input" value="13" /></div>
                <div class="col-md-1"><button type="button" class="btn btn-outline-danger w-100" onclick="mart.removeLine(this)">×</button></div>
            </div>`);
        bindProductSelect(document.querySelectorAll('#lineItems .line-row').item(-1).querySelector('.product-select'));
    });
    function bindProductSelect(sel) {
        sel.addEventListener('change', async function () {
            const id = this.value;
            if (!id) return;
            const res = await fetch(`/Sales/ProductInfo/${id}`);
            const data = await res.json();
            const row = this.closest('.line-row');
            row.querySelector('.price-input').value = data.sellingPrice;
            row.querySelector('.tax-input').value = data.taxPercent;
        });
    }
    document.querySelectorAll('.product-select').forEach(bindProductSelect);
</script>
}
