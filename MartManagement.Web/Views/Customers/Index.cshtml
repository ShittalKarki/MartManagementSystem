@* MartMS *@
@model IEnumerable<Customer>
@{ ViewData["Title"] = "Customers"; }
<div class="page-header">
    <h2>Customers</h2>
    <a asp-action="Create" class="btn btn-primary">Add Customer</a>
</div>
<div class="card table-card">
    <table class="table table-hover">
        <thead><tr><th>Name</th><th>Phone</th><th>Email</th><th></th></tr></thead>
        <tbody>
        @foreach (var c in Model)
        {
            <tr>
                <td>@c.Name</td>
                <td>@c.Phone</td>
                <td>@c.Email</td>
                <td class="text-end">
                    <a asp-action="Details" asp-route-id="@c.Id" class="btn btn-sm btn-outline-secondary">History</a>
                    <a asp-action="Edit" asp-route-id="@c.Id" class="btn btn-sm btn-outline-primary">Edit</a>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>
