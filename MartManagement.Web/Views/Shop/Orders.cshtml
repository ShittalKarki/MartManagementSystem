@* MartMS *@
@model IEnumerable<Sale>
@{
    ViewData["Title"] = "My Orders";
}

<div class="shop-section-header mb-4">
    <div>
        <h1 class="h3 fw-bold mb-1">My orders</h1>
        <p class="text-muted mb-0">Track your purchase history</p>
    </div>
    <a asp-action="Index" asp-route-catalog="true" class="btn btn-shop-primary btn-sm"><i class="bi bi-basket me-1"></i>Shop more</a>
</div>

@if (!Model.Any())
{
    <div class="shop-empty-state">
        <i class="bi bi-receipt"></i>
        <h5>No orders yet</h5>
        <p class="text-muted">When you place an order, it will appear here.</p>
        <a asp-action="Index" class="btn btn-shop-primary mt-2">Browse products</a>
    </div>
}
else
{
    @foreach (var o in Model)
    {
        var isRecent = (DateTime.UtcNow - o.SaleDate).TotalHours < 2;
        <div class="order-card">
            <div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-2">
                <div>
                    <span class="fw-bold">@o.InvoiceNumber</span>
                    <span class="order-status @(isRecent ? "processing" : "completed") ms-2">@(isRecent ? "Processing" : "Completed")</span>
                </div>
                <span class="fw-bold text-primary">Rs. @o.TotalAmount.ToString("N2")</span>
            </div>
            <p class="text-muted small mb-3"><i class="bi bi-calendar3 me-1"></i>@o.SaleDate.ToLocalTime().ToString("f")</p>
            <div class="d-flex flex-wrap gap-2">
                <a asp-action="OrderDetails" asp-route-id="@o.Id" class="btn btn-sm btn-outline-primary"><i class="bi bi-eye me-1"></i>View details</a>
                <a asp-action="Invoice" asp-route-id="@o.Id" class="btn btn-sm btn-light" target="_blank"><i class="bi bi-file-earmark-pdf me-1"></i>Invoice</a>
            </div>
        </div>
    }
}
