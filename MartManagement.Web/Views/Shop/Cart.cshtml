@* MartMS *@
@model CartSummaryViewModel
@{
    ViewData["Title"] = "Shopping Cart";
}

<div class="shop-section-header mb-4">
    <div>
        <h1 class="h3 fw-bold mb-1">Shopping cart</h1>
        <p class="text-muted mb-0">@Model.ItemCount item(s) in your cart</p>
    </div>
    <a asp-action="Index" asp-route-catalog="true" class="btn btn-outline-primary btn-sm"><i class="bi bi-arrow-left me-1"></i>Continue shopping</a>
</div>

@if (!Model.Items.Any())
{
    <div class="shop-empty-state">
        <i class="bi bi-cart-x"></i>
        <h5>Your cart is empty</h5>
        <p class="text-muted">Looks like you haven't added anything yet.</p>
        <a asp-action="Index" class="btn btn-shop-primary mt-2">Browse products</a>
    </div>
}
else
{
    <div class="row g-4">
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
                @foreach (var item in Model.Items)
                {
                    <div class="cart-item-row px-3 mx-0">
                        <div class="cart-item-thumb">
                            @if (!string.IsNullOrEmpty(item.ImagePath))
                            {
                                <img src="@item.ImagePath" alt="" />
                            }
                            else
                            {
                                <div class="product-img-placeholder" style="background:@ShopDisplayHelper.PlaceholderGradient(item.ProductId);height:100%;font-size:1.25rem"><i class="bi bi-box-seam"></i></div>
                            }
                        </div>
                        <div class="flex-grow-1">
                            <a asp-action="Details" asp-route-id="@item.ProductId" class="fw-semibold text-decoration-none text-dark">@item.Name</a>
                            <div class="text-muted small">Rs. @item.UnitPrice.ToString("N2") each</div>
                            <form asp-action="UpdateCart" method="post" class="d-flex align-items-center gap-2 mt-2">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="productId" value="@item.ProductId" />
                                <div class="qty-stepper">
                                    <button type="button" class="qty-minus" onclick="this.form.querySelector('input').stepDown(); this.form.submit()"><i class="bi bi-dash"></i></button>
                                    <input type="number" name="quantity" value="@item.Quantity" min="1" max="@item.StockAvailable" onchange="this.form.submit()" />
                                    <button type="button" class="qty-plus" onclick="this.form.querySelector('input').stepUp(); this.form.submit()"><i class="bi bi-plus"></i></button>
                                </div>
                            </form>
                        </div>
                        <div class="text-end">
                            <div class="fw-bold">Rs. @item.LineTotal.ToString("N2")</div>
                            <form asp-action="RemoveFromCart" method="post" class="mt-1">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="productId" value="@item.ProductId" />
                                <button class="btn btn-link btn-sm text-danger p-0">Remove</button>
                            </form>
                        </div>
                    </div>
                }
            </div>
        </div>
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm rounded-4 p-4 sticky-top" style="top:90px">
                <h5 class="fw-bold mb-3">Order summary</h5>
                <div class="d-flex justify-content-between small mb-2"><span>Subtotal</span><span>Rs. @Model.Subtotal.ToString("N2")</span></div>
                <div class="d-flex justify-content-between small mb-2"><span>Tax</span><span>Rs. @Model.Tax.ToString("N2")</span></div>
                <hr />
                <div class="d-flex justify-content-between fw-bold fs-5 mb-4"><span>Total</span><span class="text-primary">Rs. @Model.Total.ToString("N2")</span></div>
                <form asp-action="Checkout" method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-shop-primary w-100 btn-lg"><i class="bi bi-bag-check me-2"></i>Place order</button>
                </form>
            </div>
        </div>
    </div>
}
