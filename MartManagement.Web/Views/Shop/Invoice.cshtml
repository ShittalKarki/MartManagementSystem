@* MartMS *@
@model Sale
@{
    Layout = null;
    ViewData["Title"] = "Invoice " + Model.InvoiceNumber;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>Invoice @Model.InvoiceNumber - MartMS</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <style>
        body { background: #f8fafc; padding: 2rem; }
        @@media print { body { padding: 0; background: #fff; } }
    </style>
</head>
<body>
    <div class="no-print text-end mb-3">
        <button onclick="window.print()" class="btn btn-primary"><i class="bi bi-printer"></i> Print / Save as PDF</button>
        <button onclick="window.close()" class="btn btn-outline-secondary ms-1">Close</button>
    </div>
    <div class="invoice-customer">
        <div class="text-center mb-4 pb-3 border-bottom">
            <h2 class="fw-bold mb-0" style="color:#0d9488">MartMS Shop</h2>
            <p class="text-muted mb-0">Sales Invoice</p>
        </div>
        <div class="row mb-4">
            <div class="col-6">
                <p class="mb-1"><strong>Invoice #</strong> @Model.InvoiceNumber</p>
                <p class="mb-0 text-muted small">@Model.SaleDate.ToLocalTime().ToString("f")</p>
            </div>
            <div class="col-6 text-end">
                <p class="mb-1"><strong>Customer</strong></p>
                <p class="mb-0">@(Model.Customer?.Name ?? "Customer")</p>
                <p class="mb-0 text-muted small">@(Model.Customer?.Email)</p>
            </div>
        </div>
        <table class="table table-bordered">
            <thead class="table-light">
                <tr><th>Product</th><th>Qty</th><th>Unit price</th><th class="text-end">Total</th></tr>
            </thead>
            <tbody>
            @foreach (var line in Model.Items)
            {
                <tr>
                    <td>@line.Product.Name</td>
                    <td>@line.Quantity</td>
                    <td>Rs. @line.UnitPrice.ToString("N2")</td>
                    <td class="text-end">Rs. @line.LineTotal.ToString("N2")</td>
                </tr>
            }
            </tbody>
        </table>
        <div class="text-end">
            <p class="mb-1">Subtotal: Rs. @Model.Subtotal.ToString("N2")</p>
            <p class="mb-1">Tax: Rs. @Model.TaxAmount.ToString("N2")</p>
            @if (Model.DiscountAmount > 0) { <p class="mb-1">Discount: Rs. @Model.DiscountAmount.ToString("N2")</p> }
            <h4 class="fw-bold mt-2">Total: Rs. @Model.TotalAmount.ToString("N2")</h4>
        </div>
        <p class="text-center text-muted small mt-4 mb-0">Thank you for shopping with MartMS!</p>
    </div>
    <script>window.onload = function() { /* optional auto-print: window.print(); */ };</script>
</body>
</html>
