@* MartMS *@
@model CustomerProfileViewModel
@{
    Layout = "_CustomerLayout";
    ViewData["Title"] = "My Profile";
    var initial = string.IsNullOrEmpty(Model.FullName) ? "C" : Model.FullName[..1].ToUpper();
}

<div class="row g-4">
    <div class="col-lg-4">
        <div class="profile-sidebar">
            <div class="profile-avatar">@initial</div>
            <h4 class="fw-bold mb-1">@Model.FullName</h4>
            <p class="opacity-75 small mb-0">@Model.Email</p>
            <div class="profile-stat">
                <div class="small opacity-75">Total orders</div>
                <div class="fs-4 fw-bold">@Model.OrderCount</div>
            </div>
            <div class="profile-stat">
                <div class="small opacity-75">Total spent</div>
                <div class="fs-5 fw-bold">Rs. @Model.TotalSpent.ToString("N2")</div>
            </div>
            <a asp-controller="Shop" asp-action="Orders" class="btn btn-light btn-sm w-100 mt-3">View order history</a>
        </div>
    </div>
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm rounded-4 p-4">
            <h5 class="fw-bold mb-4"><i class="bi bi-person-gear me-2"></i>Account settings</h5>
            <form asp-action="ProfileCustomer" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />
                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>
                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="FullName" class="form-label fw-semibold"></label>
                        <input asp-for="FullName" class="form-control" />
                        <span asp-validation-for="FullName" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Username" class="form-label fw-semibold"></label>
                        <input asp-for="Username" class="form-control" readonly />
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Email" class="form-label fw-semibold"></label>
                        <input asp-for="Email" class="form-control" />
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Phone" class="form-label fw-semibold"></label>
                        <input asp-for="Phone" class="form-control" placeholder="Phone number" />
                    </div>
                    <div class="col-12">
                        <label asp-for="Address" class="form-label fw-semibold"></label>
                        <textarea asp-for="Address" class="form-control" rows="2" placeholder="Delivery address"></textarea>
                    </div>
                </div>
                <hr class="my-4" />
                <h6 class="fw-bold mb-3"><i class="bi bi-shield-lock me-2"></i>Change password</h6>
                <p class="text-muted small">Leave blank to keep your current password.</p>
                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="NewPassword" class="form-label"></label>
                        <input asp-for="NewPassword" class="form-control" />
                    </div>
                    <div class="col-md-6">
                        <label asp-for="ConfirmPassword" class="form-label"></label>
                        <input asp-for="ConfirmPassword" class="form-control" />
                    </div>
                </div>
                <button type="submit" class="btn btn-shop-primary mt-4 px-4"><i class="bi bi-check-lg me-1"></i>Save changes</button>
            </form>
        </div>
    </div>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
