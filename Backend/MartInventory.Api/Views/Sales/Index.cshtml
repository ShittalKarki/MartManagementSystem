@model OrderHistoryViewModel
@{
    ViewData["Title"] = "Sales";
}

<div class="d-flex justify-content-end mt-3">
    <a asp-action="Create" class="btn btn-success">Create Sale</a>
</div>

<div class="card mt-3">
    <div class="table-responsive">
        <table class="table mb-0">
            <thead><tr><th>Date</th><th>Invoice</th><th>Customer</th><th>Items</th><th>Total</th><th></th></tr></thead>
            <tbody>
                @foreach (var item in Model.RecentSales)
                {
                    <tr>
                        <td>@item.SoldAt.ToLocalTime().ToString("dd MMM yyyy HH:mm")</td>
                        <td>@item.InvoiceNumber</td>
                        <td>@(item.Customer?.Name ?? "Walk-in")</td>
                        <td>@item.Lines.Count</td>
                        <td>NPR @item.TotalAmount.ToString("N2")</td>
                        <td><a asp-action="Invoice" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Invoice</a></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
