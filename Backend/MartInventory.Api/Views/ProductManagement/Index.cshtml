@model ProductIndexViewModel
@{
    ViewData["Title"] = "Products";
}

<div class="card mt-3">
    <div class="card-body">
        <form method="get" class="row g-2">
            <div class="col-md-4">
                <input type="text" name="search" value="@Model.Search" class="form-control" placeholder="Search by name, SKU, barcode" />
            </div>
            <div class="col-md-3">
                <select class="form-select" name="categoryId">
                    <option value="">All Categories</option>
                    @foreach (var cat in Model.Categories)
                    {
                        <option value="@cat.Id" selected="@(Model.CategoryId == cat.Id)">@cat.Name</option>
                    }
                </select>
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-primary">Filter</button>
            </div>
            @if (User.IsInRole("Admin"))
            {
                <div class="col-auto ms-auto">
                    <a asp-action="Create" class="btn btn-success">Add Product</a>
                </div>
            }
        </form>
    </div>
</div>

<div class="card mt-3">
    <div class="table-responsive">
        <table class="table mb-0">
            <thead>
                <tr>
                    <th>SKU</th>
                    <th>Name</th>
                    <th>Category</th>
                    <th>Stock</th>
                    <th>Selling Price</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.PagedProducts.Items)
                {
                    <tr>
                        <td>@item.Sku</td>
                        <td>@item.Name</td>
                        <td>@item.Category.Name</td>
                        <td>
                            <span class="badge @(item.StockOnHand <= item.ReorderLevel ? "bg-danger" : "bg-success")">@item.StockOnHand</span>
                        </td>
                        <td>NPR @item.SellingPrice.ToString("N2")</td>
                        <td class="text-end">
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Edit</a>
                            @if (User.IsInRole("Admin"))
                            {
                                <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline" onsubmit="return mart.confirmSubmit('Delete this product?');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<div class="d-flex justify-content-between mt-3">
    <small class="text-muted">Total @Model.PagedProducts.TotalCount records</small>
    <div>
        @if (Model.PagedProducts.HasPrevious)
        {
            <a class="btn btn-sm btn-outline-secondary" asp-route-page="@(Model.PagedProducts.PageNumber - 1)" asp-route-search="@Model.Search" asp-route-categoryId="@Model.CategoryId">Previous</a>
        }
        @if (Model.PagedProducts.HasNext)
        {
            <a class="btn btn-sm btn-outline-secondary" asp-route-page="@(Model.PagedProducts.PageNumber + 1)" asp-route-search="@Model.Search" asp-route-categoryId="@Model.CategoryId">Next</a>
        }
    </div>
</div>
