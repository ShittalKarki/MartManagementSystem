@model DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
}

<div class="row g-3 mt-2">
    <div class="col-md-6 col-xl-3">
        <div class="card p-3">
            <small class="text-muted">Total Products</small>
            <div class="h3 mb-0">@Model.TotalProducts</div>
        </div>
    </div>
    <div class="col-md-6 col-xl-3">
        <div class="card p-3">
            <small class="text-muted">Total Categories</small>
            <div class="h3 mb-0">@Model.TotalCategories</div>
        </div>
    </div>
    <div class="col-md-6 col-xl-3">
        <div class="card p-3">
            <small class="text-muted">Today Sales</small>
            <div class="h3 mb-0">NPR @Model.TodaySales.ToString("N2")</div>
        </div>
    </div>
    <div class="col-md-6 col-xl-3">
        <div class="card p-3">
            <small class="text-muted">Low Stock Alerts</small>
            <div class="h3 mb-0 text-danger">@Model.LowStockCount</div>
        </div>
    </div>
</div>

<div class="row g-3 mt-1">
    <div class="col-lg-8">
        <div class="card p-3">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <h2 class="h6 mb-0">Last 7 Days Sales</h2>
                <span class="badge bg-light text-dark">Monthly: NPR @Model.MonthSales.ToString("N2")</span>
            </div>
            <canvas id="salesChart" height="110"></canvas>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="card p-3">
            <h2 class="h6">Today Purchases</h2>
            <p class="display-6">NPR @Model.TodayPurchases.ToString("N2")</p>
        </div>
    </div>
</div>

<div class="card mt-3">
    <div class="card-header bg-white">
        <h2 class="h6 mb-0">Recent Stock Movements</h2>
    </div>
    <div class="table-responsive">
        <table class="table mb-0">
            <thead>
                <tr>
                    <th>Date</th>
                    <th>Product</th>
                    <th>Type</th>
                    <th>Qty</th>
                    <th>Stock</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.RecentMovements)
                {
                    <tr>
                        <td>@item.CreatedAt.ToLocalTime().ToString("dd MMM yyyy HH:mm")</td>
                        <td>@item.Product.Name</td>
                        <td>@item.MovementType</td>
                        <td>@item.Quantity</td>
                        <td>@item.PreviousStock -> @item.NewStock</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        const labels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Last7DaysLabels));
        const values = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Last7DaysSales));
        const chartElement = document.getElementById("salesChart");
        if (chartElement && window.Chart) {
            new Chart(chartElement, {
                type: "line",
                data: {
                    labels,
                    datasets: [{
                        label: "Sales (NPR)",
                        data: values,
                        borderColor: "#0d6efd",
                        backgroundColor: "rgba(13, 110, 253, 0.12)",
                        fill: true,
                        tension: 0.3
                    }]
                },
                options: { plugins: { legend: { display: false } } }
            });
        }
    </script>
}
