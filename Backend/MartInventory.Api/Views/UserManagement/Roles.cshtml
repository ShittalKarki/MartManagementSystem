@model UpdateUserRolesViewModel
@{
    ViewData["Title"] = "Update Roles";
}

<div class="card mt-3"><div class="card-body">
    <h5 class="mb-3">@Model.Email</h5>
    <form asp-action="Roles" asp-route-id="@Model.UserId" method="post">
        @Html.AntiForgeryToken()
        <input asp-for="UserId" type="hidden" />
        <div class="mb-3">
            <label class="form-label">Roles</label>
            @foreach (var role in Model.AvailableRoles)
            {
                var checkedValue = Model.SelectedRoles.Contains(role);
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" name="SelectedRoles" value="@role" checked="@checkedValue" id="role_@role" />
                    <label class="form-check-label" for="role_@role">@role</label>
                </div>
            }
        </div>

        <button class="btn btn-primary" type="submit">Update Roles</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Back</a>
    </form>
</div></div>
