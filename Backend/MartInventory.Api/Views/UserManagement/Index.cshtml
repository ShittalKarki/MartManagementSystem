@model UserManagementIndexViewModel
@{
    ViewData["Title"] = "User Management";
}

<div class="card mt-3"><div class="card-body">
    <form method="get" class="row g-2">
        <div class="col-md-4"><input name="search" value="@Model.Search" class="form-control" placeholder="Search users" /></div>
        <div class="col-auto"><button class="btn btn-primary">Filter</button></div>
    </form>
</div></div>

<div class="card mt-3"><div class="table-responsive">
<table class="table mb-0">
    <thead><tr><th>Email</th><th>Full Name</th><th>Roles</th><th>Status</th><th></th></tr></thead>
    <tbody>
    @foreach (var user in Model.Users)
    {
        <tr>
            <td>@user.Email</td>
            <td>@user.FullName</td>
            <td>@string.Join(", ", user.Roles)</td>
            <td>@(user.IsLocked ? "Locked" : "Active")</td>
            <td class="text-end"><a asp-action="Roles" asp-route-id="@user.Id" class="btn btn-sm btn-outline-primary">Roles</a></td>
        </tr>
    }
    </tbody>
</table>
</div></div>
